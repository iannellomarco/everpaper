e":"heading","tags":["docs"],"url":"/release-notes#140","content":"1.4.0"},"751":{"id":"/release-notes-55","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#131","content":"1.3.1"},"752":{"id":"/release-notes-56","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#130","content":"1.3.0"},"753":{"id":"/release-notes-57","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#120","content":"1.2.0"},"754":{"id":"/release-notes-58","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#111","content":"1.1.1"},"755":{"id":"/release-notes-59","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#110","content":"1.1.0"},"756":{"id":"/release-notes-60","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#1012","content":"1.0.12"},"757":{"id":"/release-notes-61","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#1011","content":"1.0.11"},"758":{"id":"/release-notes-62","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#1010","content":"1.0.10"},"759":{"id":"/release-notes-63","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#109","content":"1.0.9"},"760":{"id":"/release-notes-64","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#108","content":"1.0.8"},"761":{"id":"/release-notes-65","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#107","content":"1.0.7"},"762":{"id":"/release-notes-66","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#106","content":"1.0.6"},"763":{"id":"/release-notes-67","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#105","content":"1.0.5"},"764":{"id":"/release-notes-68","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#104","content":"1.0.4"},"765":{"id":"/release-notes-69","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#103","content":"1.0.3"},"766":{"id":"/release-notes-70","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#102","content":"1.0.2"},"767":{"id":"/release-notes-71","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#101","content":"1.0.1"},"768":{"id":"/release-notes-72","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#100","content":"1.0.0"},"769":{"id":"/release-notes-73","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#day-journal","content":"Day Journal"},"770":{"id":"/release-notes-74","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#meetings","content":"Meetings"},"771":{"id":"/release-notes-75","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#second-brain","content":"Second Brain"},"772":{"id":"/release-notes-76","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#on-device-by-default","content":"On-device by default"},"773":{"id":"/release-notes-77","page_id":"/release-notes","type":"heading","tags":["docs"],"url":"/release-notes#requirements","content":"Requirements"},"774":{"id":"/release-notes-78","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes","content":"What's new in Everpaper, newest first. During the private beta each build\narrives as a download link and installs over the previous one; automatic\nupdates begin with the first public release. See\nUpdates & Support."},"775":{"id":"/release-notes-79","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes","content":"Everpaper is the new name for Hindsight — same app, same data, same\npermissions. Entries below from before the rename describe Hindsight as it\nwas branded at the time and are left as originally written."},"776":{"id":"/release-notes-80","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes","content":"Entries marked **beta** are pre-release builds shared with testers ahead of a\npublic version. Automatic updates never offer them."},"777":{"id":"/release-notes-81","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"A new look, a launcher on ⌥Space, Dictate on fn, and a journal that knows what\nday it is."},"778":{"id":"/release-notes-82","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"**A new design.** The soft glass and warm paper of the setup pages now run\nthrough the whole app. Same places, same names, calmer to look at."},"779":{"id":"/release-notes-83","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"**A launcher on ⌥Space.** Press it anywhere and type. It finds apps,\nSettings panes, commands, files (and what's inside them), images, a quick\ncalculation, and everything Everpaper remembers, with a web search when\nnothing matches."},"780":{"id":"/release-notes-84","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"**Clipboard history.** The launcher also keeps what you copy, so you can\npaste something from earlier. It is on by default, keeps copies for 7 days,\nstays on this Mac, and skips passwords that apps mark as secret, private\nwindows it can detect, and the apps and sites you skip. Everpaper tells you\nonce and lets you turn it off on the spot, or later in Settings."},"781":{"id":"/release-notes-85","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"**Dictate on fn.** Hold fn, speak, let go, and your words land where the\ncursor is. It works in Italian and English, and a sentence that mixes the two\nstays as you said it: the clean-up no longer translates the smaller\nlanguage. It runs on this Mac with the speech model you already have, never\ndownloads anything on its own, and is off until you turn it on, in setup or\nin **Settings → Dictation**. Turning it on asks for the microphone."},"782":{"id":"/release-notes-86","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"**Journal dates that are right.** The journal now knows today's date and the\nweek around it, so \"yesterday\", \"next Friday\" or \"5-9 Oct\" become real dates\ninstead of guesses."},"783":{"id":"/release-notes-87","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"**A fact check on the journal.** After writing, Everpaper checks the dates\nand names in the entry against what you actually did that day. If one isn't\nin the record, it asks the AI once to rewrite that part, and keeps the\nwarmth. On very full days the check may be skipped and the entry is kept as\nwritten."},"784":{"id":"/release-notes-88","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"**Fixes.** A dictation on a day without a journal now shows up in the\nhistory. A crash in the on-device sentence model is fixed. A journal digest\nthat retried for hours now gives up cleanly. Dates are no longer read into\nordinary words such as \"set 5 reminders\". Setup options answer VoiceOver. On\nthe screen: the ribbon sits in the masthead, Today's last line stays\nvisible, the progress track is readable in dark mode, and the related-moments\nswitch moved to **Daily history**."},"785":{"id":"/release-notes-89","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b101--beta","content":"Requires macOS 15 or later, Apple Silicon."},"786":{"id":"/release-notes-90","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"Search finds things by what they mean, and Everpaper is much lighter on your\nMac."},"787":{"id":"/release-notes-91","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**A new welcome and setup.** First-run setup has been redesigned to read like\nthe pages of a book: each step turns to the next, a thin ribbon marks your\nprogress, and your choices sit on soft glass over warm paper (plain paper\nbefore macOS 26, or with Reduce transparency on). The steps are the same as\nbefore, and a last page lists each part of your setup as ready, still\npreparing, or left for later."},"788":{"id":"/release-notes-92","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Setup chooses nothing for you.** Moving through the pages changes nothing:\nsettings are saved only when you pick something, and models download only\nwhen you press Prepare. Permission buttons ask macOS directly and offer a\nshortcut to System Settings if a request isn't granted. You finish on Today\nor Meetings, depending on what you chose, and finishing never starts a\nrecording. Run setup again from **Settings → General**. The animated 3D\nribbon and the \"Make yourself at home\" banner are gone."},"789":{"id":"/release-notes-93","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Search that understands what you mean.** A new on-device search model,\nEmbeddingGemma-2, searches your memory, files and meetings. It finds the\nright moment even when you describe it in other words, or in another\nlanguage, and exact names and phrases still match first. Your searches stay\non this Mac."},"790":{"id":"/release-notes-94","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Files found by meaning.** In the Concordance, the Files list (and the file\nrows in Everything) shows keyword matches at once, then adds the files that\nmatch what you meant a moment later."},"791":{"id":"/release-notes-95","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Screenshots and meeting audio, searchable.** On macOS 27, a screenshot can\nbe found by describing what it shows, even with no readable text, and a\nmeeting recording by its sound, not only its transcript; the result opens\nthe matching part of the transcript. Before macOS 27, search by meaning works\nfor text."},"792":{"id":"/release-notes-96","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Setting up search.** The search model is a one-time download of about\n1.5 GB. New users can prepare it during setup; existing users see a card\noffering it. It prepares in the background at a quiet moment, search works\nas before until it's ready, and older history is brought up to date\ngradually. If you cancel or choose Set up later, Everpaper waits a week\nbefore downloading it in the background. To go back, choose Apple (previous)\nunder **Search model** in **Settings → AI & summaries**; nothing is lost."},"793":{"id":"/release-notes-97","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Related moments.** When a meeting starts, or a document stays in front for\na little while, Everpaper can quietly list up to three related past moments,\nmeetings or files: on the meeting desk for meetings, on Today for documents.\nThere are no notifications, and skipped apps, skipped sites and private\nwindows never trigger it. Turn it off with **Show related moments** in\n**Settings → Speech**."},"794":{"id":"/release-notes-98","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Much lighter while you type.** Adaptive visual history writes a tiny\nfraction of what it used to while you type. In our tests, two minutes of\ntyping went from gigabytes written to under a megabyte, with far less\nprocessor use."},"795":{"id":"/release-notes-99","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Lighter during meetings.** The recording dots, the meeting pill and the\nmeeting desk no longer pulse, the desk waveform redraws only when there's new\nsound, and spinners stop when their window is hidden. The live preview no\nlonger writes temporary audio files, and the live meeting summary reads only\nwhat was said since its last update."},"796":{"id":"/release-notes-100","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Less repeated work.** At launch, AI work waits for the first quiet moment.\nFinish day returns sooner and names the day's activities afterwards. The\nToday summary and the day's extraction aren't redone when nothing changed,\nand stopping an AI answer no longer restarts the on-device model. Old model\ncache files are cleaned up, and downloaded models are kept out of Time\nMachine backups."},"797":{"id":"/release-notes-101","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**AI waits for the right moment.** Background AI work runs through one\nqueue, and anything you're waiting for goes first. Background jobs hold off\nwhile another app uses the microphone, while you record a meeting, in full\nscreen, when the Mac is hot or short on memory and in Low Power Mode; a\nlocked screen counts as a quiet moment, so waiting work catches up then, and\nwork with a deadline still gets done in time. Settings\nand Today say why work is paused, and **AI use today** in\n**Settings → General** shows how much each feature used the AI today."},"798":{"id":"/release-notes-102","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**A new permission for call audio.** Meetings now record the call's sound\nthrough macOS system audio recording, which is much lighter than screen\ncapture. Everpaper asks for the System Audio Recording permission before your\nfirst meeting, never during one. If you decline, meetings are recorded\nthrough screen capture as before, and you can ask again from Settings.\nSwitching speakers or headphones mid-meeting, Bluetooth included, no longer\nloses the recording."},"799":{"id":"/release-notes-103","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Visual history keeps going while you read, watch or meet.** Adaptive\nvisual history used to pause when you weren't typing or clicking. Now it\nkeeps its rhythm, at most one checkpoint every 30 seconds and only when the\nscreen actually changed, including during recorded meetings, with your skip\nrules applied. Nothing is captured while the display sleeps or the screen is\nlocked."},"800":{"id":"/release-notes-104","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**Journal.** Running notes build up through the day instead of being\nrewritten each time, with one full tidy-up in the evening. New and off by\ndefault, **Journal threads** in **Settings → AI & summaries** groups the day\nby topic and lets the evening entry recall related moments from earlier\ndays. In our tests it made entries more factual but less personal."},"801":{"id":"/release-notes-105","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"**llama.cpp engine (experimental), off by default.** A new switch in\n**Settings → AI & summaries** runs a Gemma model on this Mac through a\ndifferent engine. It needs 16 GB of memory or more and downloads its model\nthe first time you turn it on. Turning it off returns to the AI option you\nhad before."},"802":{"id":"/release-notes-106","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"Known limits: preparing the search model takes a few minutes the first time\nand again after a macOS update; until then, search works as before. Bringing\nolder history up to date can take a while on a large library."},"803":{"id":"/release-notes-107","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"804":{"id":"/release-notes-108","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b100--beta","content":"Requires macOS 15 or later, Apple Silicon. Screenshot and meeting-audio search\nneed macOS 27."},"805":{"id":"/release-notes-109","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"Screenshots for your journal are now opt-out: you choose what stays out, and\neverything else is captured."},"806":{"id":"/release-notes-110","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"**Capture is opt-out.** Before, Everpaper took a screenshot only when it\ncould prove a window was safe. Now it takes one unless what's in front is an\napp or site you skip, or a private browsing window. Timed screenshots and\nAdaptive window shots follow the same rules, so the two can't disagree."},"807":{"id":"/release-notes-111","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"**Email and chat are no longer skipped on their own.** Adaptive window shots\nused to leave out email, chat and messaging apps and sites by themselves. If\nyou want them kept out, add them to your skip lists; **Skip sites** offers\nthem as one-tap suggestions."},"808":{"id":"/release-notes-112","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"**New: Skip sites.** In **Settings → Privacy**, list the websites to keep out\nof screenshots while they're in front. Subdomains are skipped too: skipping\nexample.com also skips mail.example.com. Type an address or tap a\nsuggestion; nothing is skipped until you add it."},"809":{"id":"/release-notes-113","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"**New: Skip private browsing windows.** A new switch in\n**Settings → Privacy**, on by default. While a private or incognito window is\nin front, Everpaper takes no screenshot and keeps no window title. With the\nbrowser extension it uses the browser's own private-window state; without\nit, it looks for the marker browsers put in the window title."},"810":{"id":"/release-notes-114","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"**Window shots in browsers, with or without the extension.** Adaptive visual\nhistory now takes window shots in browsers without the Everpaper extension\ntoo, reading the page address and window title through macOS Accessibility.\nSkipped sites and private windows are still left out."},"811":{"id":"/release-notes-115","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"**\"Events + focused fallback\" is gone.** The capture mode has been removed\nfrom setup and Settings. If you used it, Everpaper moves you to Adaptive\nvisual history automatically; you can pick another mode in\n**Settings → Daily history** at any time."},"812":{"id":"/release-notes-116","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"Known limits: timed screenshots cover your whole display, so a skipped site\nor a private window that is visible but not in front can still appear in\none. Without the extension, private-window detection depends on the window\ntitle and may miss some browsers or languages. A private window Everpaper\ncan't recognize is treated as a normal one, so add sensitive sites to\n**Skip sites** as well."},"813":{"id":"/release-notes-117","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"814":{"id":"/release-notes-118","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b99--beta","content":"Requires macOS 15 or later, Apple Silicon."},"815":{"id":"/release-notes-119","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"Gemma 4 runs inside Everpaper on macOS 27."},"816":{"id":"/release-notes-120","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**Gemma 4 inside Everpaper Native.** On macOS 27 Macs with 16 GB of memory\nor more, Everpaper Native now runs Gemma 4 E4B, the model that wrote the best\nevening entries in our tests. It runs inside Everpaper, so you don't need\nLM Studio, Ollama or any other server."},"817":{"id":"/release-notes-121","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**Clear sizes, careful switch.** The download is about 5.9 GB, and the\ninstalled model takes about 8.5 GB (some tools show 7.9 GB). Setup checks\nthere's room for both before it starts, and switches over only after Gemma\nhas answered a first request. If the connection drops for a moment, the\ndownload retries and carries on where it stopped."},"818":{"id":"/release-notes-122","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**Setup picks it for you.** On these Macs, guided setup now chooses\nEverpaper Native with Gemma. A running LM Studio or Ollama with a chat model\nis still used, and an AI setup you already have is kept. macOS 27 Macs with\nless than 16 GB keep Qwen3 4B; earlier macOS versions work as in b97."},"819":{"id":"/release-notes-123","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**Already on Everpaper Native with Qwen?** A one-time card offers the switch\nto Gemma and shows its sizes. Qwen keeps answering while Gemma downloads, and\nits files (about 2.3 GB) stay until you remove them."},"820":{"id":"/release-notes-124","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**Native models by name.** In **Settings → AI & summaries**, Everpaper Native\nlists the models on this Mac by name. You can set one up there, or remove one\nyou no longer use."},"821":{"id":"/release-notes-125","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**A steadier engine.** Prompts are formatted exactly as Gemma expects. An\nanswer cut off at its length limit no longer garbles the next one, and output\nmade only of internal marker tokens counts as a failure, so it never reaches\nyour journal. Structured answers on long prompts use about 1 GB of memory\ninstead of about 5.8 GB. One engine now stays loaded, closes after ten idle\nminutes, and restarts between requests if its memory grows too much."},"822":{"id":"/release-notes-126","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**Running notes are protected.** If a rewrite of the day's running notes\ndrops more than half of them, Everpaper keeps the earlier notes and adds the\nnew ones after."},"823":{"id":"/release-notes-127","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"**One-time setup cards are back.** Recent betas carried a name suffix that\nsilently held back Everpaper's one-time setup cards. This build doesn't, so\nyou may now see the speaker-labels card b97 meant to show."},"824":{"id":"/release-notes-128","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"Known limits: Gemma in Everpaper Native hasn't been tried on a real 16 GB Mac\nyet. The first request after the engine starts can take around half a\nminute, and after a restart the next request pauses for a few seconds.\nEvening entries still condense busy days and drop some meeting details. When\nseveral people share your Mac's microphone, the live transcript shows them\nall as \"Me\" until the meeting ends; the saved transcript separates them."},"825":{"id":"/release-notes-129","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"826":{"id":"/release-notes-130","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b98--beta","content":"Requires macOS 15 or later, Apple Silicon. Gemma 4 in Everpaper Native needs\nmacOS 27 and 16 GB of memory or more."},"827":{"id":"/release-notes-131","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"Your daily journal reads like a diary again, meetings get a summary, and\nGemma 4 joins the local models."},"828":{"id":"/release-notes-132","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**Everpaper now needs macOS 15 (Sequoia) or later.**"},"829":{"id":"/release-notes-133","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**An evening entry in your voice.** When you finish your day, Everpaper\nwrites one warm, first-person entry from the day's notes and meetings,\nincluding each meeting's decisions, dates and who does what. A day cut short\nby a quit or crash is written up the next time Everpaper opens."},"830":{"id":"/release-notes-134","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**Entries can outlive their screenshots.** With **Also delete their text &\nrecall data** off (Settings → Daily history), finished entries are kept when\nold screenshots are cleaned up. The switch is on for new installs, so there a\nday's entry is removed with its screenshots after your retention period."},"831":{"id":"/release-notes-135","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**A summary for meetings.** Each meeting of more than a few minutes gets a\nsummary once it ends, shown on its page and reused in the evening entry.\nLonger meetings get longer summaries. This needs an AI option set up, and a\ncloud provider needs your consent."},"832":{"id":"/release-notes-136","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**Everyday meetings: Parakeet for words, Nemotron for speakers,** live and in\nthe saved transcript. If Nemotron can't run, Everpaper falls back to its\nprevious speaker labels."},"833":{"id":"/release-notes-137","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**Clearer live speaker labels.** A new caption line starts when the speaker\nchanges; in our tests, words shown under the wrong speaker fell from about\n31% to about 10%. When several people speak into your Mac's own microphone,\nthe saved transcript separates them, and you stay \"Me\" when you're the only\none talking."},"834":{"id":"/release-notes-138","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**Ready before your first meeting.** Today warns you if transcription isn't\nset up, with one Set up button and the download size. If you skip it, the\nfirst meeting downloads the model with progress, and the audio is always\nrecorded. A missing model no longer stops a meeting, discarded recordings\nstay discarded, a microphone that goes silent is restarted, and merging\nspeakers keeps the right names."},"835":{"id":"/release-notes-139","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**Gemma 4 E4B for Macs with 24 GB or more** (about 6.9 GB). Setup reuses an\nLM Studio or Ollama you already run instead of installing a second engine.\nThinking is turned off, every downloaded file is checked, and existing setups\nare kept."},"836":{"id":"/release-notes-140","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"**A simpler Speech page:** Everyday or Detailed, your words, and an Advanced\nsection listing the models on this Mac with their sizes and a Remove button."},"837":{"id":"/release-notes-141","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"Known limits: evening entries still condense busy days. When several people\nshare your Mac's microphone, the live transcript shows everyone as \"Me\" until\nthe meeting ends."},"838":{"id":"/release-notes-142","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"839":{"id":"/release-notes-143","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b97-journal--beta","content":"Requires macOS 15 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"840":{"id":"/release-notes-144","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"Nemotron becomes the default for words and speaker labels on new setups."},"841":{"id":"/release-notes-145","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"**New setups use Nemotron for both.** New installations transcribe and label\nspeakers with Nemotron. Parakeet is still in **Settings → Speech**, and an\nengine you already picked is kept."},"842":{"id":"/release-notes-146","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"**Model setup checks every file.** Setup verifies the files it downloads and\nprepares both the after-meeting and the live speaker models. Once prepared,\nit works offline."},"843":{"id":"/release-notes-147","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"**Short live snippets keep their last word.** A word at the edge of a short\nlive chunk is no longer dropped."},"844":{"id":"/release-notes-148","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"**No phantom extra speaker.** A voice that already has a label no longer gets\na second one from a later pass."},"845":{"id":"/release-notes-149","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"**Microphone changes recover better.** Everpaper copes better when you switch\nto an audio device that uses a different format."},"846":{"id":"/release-notes-150","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"Includes b95's click fix. The old MOSS introduction card is gone."},"847":{"id":"/release-notes-151","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"To use Nemotron for both on an existing setup, open Settings → Speech, choose\nNemotron under Transcription and press Set up. In a small test Parakeet got\nmore words right, so this beta doesn't claim Nemotron is more accurate."},"848":{"id":"/release-notes-152","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"849":{"id":"/release-notes-153","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b96-nemotron--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"850":{"id":"/release-notes-154","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b95-event--beta","content":"Fixes for a crash and a hang linked to recording your clicks."},"851":{"id":"/release-notes-155","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b95-event--beta","content":"**Click details are read safely.** When Computer History notes what you\nclicked, it now reads that detail the way macOS expects. Reading it in the\nbackground could trip an error inside Everpaper's own windows, and was linked\nto a crash and a hang in b94."},"852":{"id":"/release-notes-156","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b95-event--beta","content":"**Stopping the workday twice is safe.** Stop requests are handled one at a\ntime."},"853":{"id":"/release-notes-157","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b95-event--beta","content":"**A failed save keeps your review.** If saving the day fails, the review\nstays open so you can try again."},"854":{"id":"/release-notes-158","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b95-event--beta","content":"Click details are still recorded, and capture modes and saved data are\nunchanged. The crash isn't proven fixed yet; if clicking ever feels slow,\nreport the app you were in and roughly when."},"855":{"id":"/release-notes-159","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b95-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"856":{"id":"/release-notes-160","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b95-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"857":{"id":"/release-notes-161","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b94-event--beta","content":"A fix for a crash when you start a meeting while your workday is being\nrecorded."},"858":{"id":"/release-notes-162","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b94-event--beta","content":"**Record now during a workday is steadier.** While your workday is being\nrecorded, pressing **Record now** switches Today straight to a \"workday\npaused\" status, instead of keeping the live control running through the\nchange. This targets a crash seen on b93."},"859":{"id":"/release-notes-163","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b94-event--beta","content":"Mark Moment, Stop & Review and Discard (with confirmation) stay available. A\nworkday you paused yourself still offers Resume and stays paused after the\nmeeting."},"860":{"id":"/release-notes-164","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b94-event--beta","content":"If you stop the workday while the meeting continues, Today shows the day's\nwriting and review status."},"861":{"id":"/release-notes-165","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b94-event--beta","content":"The original crash didn't reproduce on our test Mac, so treat this build as a\ntest of the fix. After a crash, Everpaper keeps what was recorded and doesn't\nresume recording on its own."},"862":{"id":"/release-notes-166","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b94-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"863":{"id":"/release-notes-167","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b94-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"864":{"id":"/release-notes-168","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"Choose Everyday or Detailed meetings, and try live speaker labels."},"865":{"id":"/release-notes-169","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"**Everyday or Detailed meetings.** Settings → Speech now opens with two\nchoices, explained by purpose and speed. The exact models are listed under\n\"What runs on my Mac\"."},"866":{"id":"/release-notes-170","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"**Live speaker labels (experimental, opt-in).** For Everyday meetings, you\ncan turn on live speaker labels after setting up a local Nemotron model of\nabout 190 MB. People on the other end get labels during the call, which may\nchange as it goes. When the model is unsure, captions keep Me / Others. The\nwords still come from the usual live recognizer."},"867":{"id":"/release-notes-171","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"**An optional after-meeting speaker check.** A separate opt-in pass checks the\nspeaker labels once the meeting ends."},"868":{"id":"/release-notes-172","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"Both are off by default, a recording never starts a model download, and saved\nmeetings stay compatible."},"869":{"id":"/release-notes-173","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"**Smoother sidebar and Settings.** The selection highlight uses one animation\ninstead of two, and Settings no longer rebuilds itself on every section\nchange."},"870":{"id":"/release-notes-174","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"When reporting a wrong or flickering label, include the meeting's length, how\nmany people spoke, and whether it was Everyday or Detailed."},"871":{"id":"/release-notes-175","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"872":{"id":"/release-notes-176","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b93-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"873":{"id":"/release-notes-177","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"The journal keeps what it has when a rewrite goes wrong."},"874":{"id":"/release-notes-178","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"**A failed rewrite no longer shrinks the day.** If the optional final rewrite\nfails or comes back much shorter, Everpaper keeps the day as its sources\nwrote it."},"875":{"id":"/release-notes-179","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"**Meetings keep their own paragraphs.** Updates from your screen no longer\nblend into meeting paragraphs; each meeting stays separate and labeled."},"876":{"id":"/release-notes-180","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"**Automatic Episodes and Chapters are paused.** No new ones are made for now;\nthe ones you have stay."},"877":{"id":"/release-notes-181","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"**History shows spans you can open.** Recorded activities are grouped into\nstretches of time, each opening its sources."},"878":{"id":"/release-notes-182","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"**Memory chat can read sources directly.** When normal search comes up short,\nAsk reads a limited set of matching sources itself and skips anything no\nlonger visible."},"879":{"id":"/release-notes-183","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"The journal isn't yet as good as it used to be, and search finds the right\nsource less often than it should."},"880":{"id":"/release-notes-184","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"881":{"id":"/release-notes-185","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b92-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"882":{"id":"/release-notes-186","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"The journal keeps one running account of your day."},"883":{"id":"/release-notes-187","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"**One account that grows through the day.** The journal no longer writes\nseparate summaries that each lose what came before. It carries a single\nrunning account and adds to it at each update."},"884":{"id":"/release-notes-188","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"**Meetings join the day in order.** Finished meetings enter the account at\nthe time they happened, with more of what was actually said, before the\nevening entry is written."},"885":{"id":"/release-notes-189","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"**Better meeting excerpts.** When a transcript has to be shortened, Everpaper\nkeeps opening questions, whole sentences and the \"but…\" that qualifies a\npoint."},"886":{"id":"/release-notes-190","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"**Changes ripple correctly.** When a source changes or is deleted, the\nsummaries built on it are refreshed together, and your own notes and titles\nare kept."},"887":{"id":"/release-notes-191","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"**Smoother Memory and sidebar.** Switching sections stutters less."},"888":{"id":"/release-notes-192","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"Existing journals aren't rewritten. The writing still depends on your local\nmodel and isn't yet as good as it used to be."},"889":{"id":"/release-notes-193","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"890":{"id":"/release-notes-194","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b91-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"891":{"id":"/release-notes-195","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"Settings, redesigned with plain names and native Mac controls."},"892":{"id":"/release-notes-196","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"**Settings pages with plain names.** Capture is now Daily history,\nTranscription & Speech is Speech, Intelligence is AI & summaries, Privacy &\nData is Privacy, Shortcuts & System is General, and This Copy is About.\nControls are standard Mac switches, menus and buttons, grouped into sections,\nand Privacy is simpler to move around."},"893":{"id":"/release-notes-197","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"**Settings opens from the sidebar.** Settings slides in from the main\nwindow's sidebar, and Back to Everpaper sits in its own sidebar."},"894":{"id":"/release-notes-198","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"**One selection style.** The highlight in both sidebars glides to what you\npick; with Reduce Motion it moves at once."},"895":{"id":"/release-notes-199","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"**System lettering for labels.** Navigation, Today's labels and shared\ncontrols use the Mac's system font. Journals, transcripts and answers keep\ntheir reading typeface."},"896":{"id":"/release-notes-200","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"Sources restored from encrypted storage open correctly."},"897":{"id":"/release-notes-201","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"Includes the b89 journal fixes and the b88 speech defaults. No new download;\npermissions and consent are unchanged."},"898":{"id":"/release-notes-202","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"899":{"id":"/release-notes-203","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b90-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"900":{"id":"/release-notes-204","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"The daily journal reads the whole day again."},"901":{"id":"/release-notes-205","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"**Each update reads its own part of the day.** In recent betas every journal\nupdate could reuse the day's first minutes, so the journal stopped moving\nearly in the day. Each update now reads the stretch of time it covers."},"902":{"id":"/release-notes-206","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"**Nothing is cut mid-field on the way to the AI.** Each piece of evidence is\nsent whole or not at all, sized to what your model can read."},"903":{"id":"/release-notes-207","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"**One long meeting no longer fills the entry.** Meeting excerpts are kept to a\nfair share and placed in time, so the rest of the day still appears."},"904":{"id":"/release-notes-208","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"**The journal says only what its sources show.** A rewrite can't turn a\nrequest into a finished task, or a scheduling question into an email you\nreceived. Where a section can't be supported, Everpaper shows the source\npassage instead."},"905":{"id":"/release-notes-209","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"**Text-only models don't get screenshots.** With LM Studio, Everpaper checks\nwhether the selected model can read images before sending any."},"906":{"id":"/release-notes-210","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"**A failed read keeps the review open.** If a source can't be read while the\nday is finished, the review stays open with an error instead of showing an\nold summary."},"907":{"id":"/release-notes-211","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"Existing journals aren't rewritten automatically. How good the writing is\nstill depends on your local model."},"908":{"id":"/release-notes-212","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"909":{"id":"/release-notes-213","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b89-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"910":{"id":"/release-notes-214","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"Meetings process faster with MOSS, your custom words help transcription, and\nword timing can be more precise."},"911":{"id":"/release-notes-215","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"**The MOSS meeting model runs leaner.** This beta uses a lighter build of the\nsame model and no longer decodes a short first attempt twice. Earlier tests\non two recordings showed about a fifth less processing time and about 30%\nless peak memory; one longer recording came out slightly worse. The original\nmodel remains the fallback, and a change takes effect after relaunch."},"912":{"id":"/release-notes-216","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"**Custom words guide the standard engine.** Words you add now act as gentle\nhints for standard transcription, so names and terms are more likely to come\nout right. With an empty list nothing changes."},"913":{"id":"/release-notes-217","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"**Optional precise word timing.** On Macs with 24 GB or more, an optional\n1.8 GB model refines when each word starts and ends, after transcription. It\ndownloads only when you press Prepare, adds some processing time, and never\nchanges the words or who said them."},"914":{"id":"/release-notes-218","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"**The end of a recording is never skipped.** Audio reading continues through\nshort reads, so the last part of a recording can't be silently left out."},"915":{"id":"/release-notes-219","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"**LM Studio answers straight away with Qwen3.5.** Everpaper switches off\nQwen3.5's hidden \"thinking\" on LM Studio; in one test a 20-second wait became\nunder a second. A reply that only thinks and never answers now shows a clear\nerror instead of an empty answer."},"916":{"id":"/release-notes-220","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"These options are on by default in this beta and can be switched off in\nSettings. The wording when a speech-model download is paused is clearer."},"917":{"id":"/release-notes-221","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"918":{"id":"/release-notes-222","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b88-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"919":{"id":"/release-notes-223","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b87-event--beta","content":"Everpaper Native answers finish when the text does."},"920":{"id":"/release-notes-224","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b87-event--beta","content":"**No more half-minute wait after a Native answer.** With Everpaper Native, an\nanswer kept running for up to about 35 seconds after its last word appeared,\nholding back its sources and the New conversation button. The engine now\nstops as soon as the answer ends; in testing, that wait dropped to about a\ntenth of a second."},"921":{"id":"/release-notes-225","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b87-event--beta","content":"**Sources arrive with the answer.** A Memory answer shows its full source\nlist as soon as it finishes, without switching tabs."},"922":{"id":"/release-notes-226","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b87-event--beta","content":"Everything else is as in b86."},"923":{"id":"/release-notes-227","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b87-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"924":{"id":"/release-notes-228","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b87-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"925":{"id":"/release-notes-229","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"A short introduction before setup, and questions about a meeting become\nconversations you can come back to."},"926":{"id":"/release-notes-230","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"**An optional introduction.** Before setup, a short interactive introduction\nshows what Everpaper remembers and how a detail you need later becomes an\nanswer with its source. Drag through the examples or skip it."},"927":{"id":"/release-notes-231","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"**Setup keeps your place.** Quit halfway and setup reopens where you were;\ngoing back keeps your choices. It explains permissions, downloads and private\nprocessing before you act. You can run it again from Settings, and finishing\nopens Today or Meetings without starting a recording."},"928":{"id":"/release-notes-232","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"**Ask a meeting in threads.** Questions about a saved meeting now live in\nconversations you can return to: a list beside the chat on wide windows, a\nmenu on narrow ones. The composer stays at the bottom, and an unsent draft\nsurvives switching conversations."},"929":{"id":"/release-notes-233","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"**Answers show what they used.** A meeting answer links to the meeting's\ntranscript and your saved notes."},"930":{"id":"/release-notes-234","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"**Commitments open in place.** Clicking a commitment opens a small popover\nbeside it with its title, status and source. Escape closes the source first,\nthen the popover."},"931":{"id":"/release-notes-235","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"**Meeting status takes less room.** Processing status sits on the meeting's\ndetails line, with Retry visible when something fails. The Transcript,\nOverview, Ask and Speakers tabs are slimmer."},"932":{"id":"/release-notes-236","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"**Recall connects a promise to what followed.** Asking the Concordance about a\ncommitment now cites both the meeting where it was made and the later work on\nit."},"933":{"id":"/release-notes-237","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"Sources stay correct when a meeting is reprocessed or corrected, or a source\nis deleted."},"934":{"id":"/release-notes-238","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"935":{"id":"/release-notes-239","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b86-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires macOS 27."},"936":{"id":"/release-notes-240","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"Computer History now records what you do by default once you opt in, and\nDetailed screen history can't record less than Screen history."},"937":{"id":"/release-notes-241","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"**One opt-in now covers what you do and what you type.** Turn on Computer\nHistory once and it records clicks, shortcuts, short selections and\nencrypted typed text in ordinary apps and sites, unless you exclude them.\nIf you already use it, nothing widens until you choose. Password fields and\nprivate browsing are never recorded."},"938":{"id":"/release-notes-242","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"**Detailed screen history can't record less than Screen history.** It keeps\nthe regular full-screen snapshots, then adds a closer look at the active\nwindow after real changes, pauses in typing, or a Moment you mark. Without\nAccessibility permission, only those extras stop."},"939":{"id":"/release-notes-243","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"**Fewer near-identical screenshots.** Routine snapshots are smaller, and\nframes that look the same as the last one are dropped before anything is\nstored or read. Moments you mark keep full quality."},"940":{"id":"/release-notes-244","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"**Quiet stretches stay short.** A long run of switching between windows no\nlonger gets written up as if it were real work."},"941":{"id":"/release-notes-245","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"**Simpler AI choice in setup.** \"Choose for me\" picks Everpaper Native with\nMOSS on macOS 27 and a managed local engine with MOSS on earlier systems.\n\"I manage local AI\" keeps every option visible. Nothing downloads until you\npress Prepare."},"942":{"id":"/release-notes-246","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"943":{"id":"/release-notes-247","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b85-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires the macOS 27 beta."},"944":{"id":"/release-notes-248","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"Computer History arrives, with a new Adaptive mode, a History that reads as\nwork, and a clearer first run."},"945":{"id":"/release-notes-249","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"**Computer History (tester builds only).** An opt-in history of what you do\non your Mac: apps and windows, clicks and shortcuts, and — only if you allow\nit — encrypted typed text. Password fields and private browsing are never\nrecorded, you can exclude apps and sites, and it's stored only on this Mac."},"946":{"id":"/release-notes-250","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"**Adaptive mode reacts to real changes.** Adaptive (today's Detailed screen\nhistory) follows the apps and windows you use, and takes an image of the\nwindow you're working in only when what you're doing changes and every\nprivacy check passes. In this build it took no full-screen screenshots. The\ntext in those images is read on this Mac."},"947":{"id":"/release-notes-251","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"**History reads as work.** A day's History now leads with Episodes: short\nwrite-ups of what you worked on, each with a title, the apps involved, how\nlong it took and any Moments you marked. The raw list of app switches and\nclicks is still there underneath, as detail."},"948":{"id":"/release-notes-252","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"**A clearer first run.** A new welcome explains Everpaper before setup\nstarts. The first choices separate what Everpaper remembers from the\npermissions setup will ask for, and the history step is wider, showing what\neach choice keeps and what it never records, with a summary that updates as\nyou choose."},"949":{"id":"/release-notes-253","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"**Honest about thin days.** Vague “Moving between…” rows are replaced with\nwhat was actually seen or typed, when that's available. When there's too\nlittle to go on, Everpaper says so instead of inventing a task or outcome."},"950":{"id":"/release-notes-254","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"951":{"id":"/release-notes-255","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b84--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires the macOS 27 beta."},"952":{"id":"/release-notes-256","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80-event--beta","content":"An early tester build of Computer History."},"953":{"id":"/release-notes-257","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80-event--beta","content":"**A first look at Computer History.** A small evaluation build, sent out\nbetween b83 and b84, that tried the opt-in history of apps, windows, clicks\nand (only if you allowed it) encrypted typed text that b84 then shipped.\nb84 and later builds replace it."},"954":{"id":"/release-notes-258","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80-event--beta","content":"This tester build includes evaluation-only Computer History modes; ordinary\nbuilds don't include them."},"955":{"id":"/release-notes-259","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80-event--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"956":{"id":"/release-notes-260","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b83--beta","content":"First-run setup now asks which intelligence route you want instead of deciding\nfor you."},"957":{"id":"/release-notes-261","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b83--beta","content":"**Setup is three screens instead of eleven.** Choose what Everpaper should\nremember — your meetings, your days, or both — and setup asks only for what\nthat choice needs."},"958":{"id":"/release-notes-262","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b83--beta","content":"**Every usable route stays visible.** Everpaper Native leads on macOS 27,\nwith Managed oMLX, detected local providers, your own endpoint, and no AI\nall available from the same screen. The redundant Apple Intelligence row is\ngone; its icon now identifies Everpaper Native."},"959":{"id":"/release-notes-263","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b83--beta","content":"**Existing local setups are reused.** Setup can rescan providers, preserves\nthe chosen route through the final receipt, and reuses installed oMLX and\nmodel files instead of downloading them again."},"960":{"id":"/release-notes-264","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b83--beta","content":"**Local model answers stay concise.** Qwen and LFM2.5 models managed by oMLX\nnow have thinking disabled at the chat-template level, so internal reasoning\ndoes not consume the answer."},"961":{"id":"/release-notes-265","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b83--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires the macOS 27 beta."},"962":{"id":"/release-notes-266","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b82--beta","content":"Meetings use MOSS by default, and the built-in intelligence path is easier to choose."},"963":{"id":"/release-notes-267","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b82--beta","content":"**MOSS is now the default meeting engine.** First-run setup names the one-time\ndownload before it begins, starts it only when you press the button, and keeps\nworking in the background while setup continues. The standard transcription\npipeline remains available as a fallback until MOSS is ready."},"964":{"id":"/release-notes-268","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b82--beta","content":"**Everpaper Native leads on macOS 27.** The built-in engine is now the\nrecommended intelligence choice during setup; a separate local engine remains\navailable as an alternative. System instructions also use the model's real\nprivileged system role."},"965":{"id":"/release-notes-269","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b82--beta","content":"**Very short recordings are handled honestly.** Recordings under five seconds\nare discarded instead of producing empty meetings, with a clear explanation\nin the recording pill."},"966":{"id":"/release-notes-270","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b82--beta","content":"**Completed meetings no longer leave a stale progress row.** The meeting list\nreconciles its live finalization state against the saved record after every\nrefresh."},"967":{"id":"/release-notes-271","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b82--beta","content":"Requires macOS 14.2 or later, Apple Silicon. Everpaper Native additionally\nrequires the macOS 27 beta."},"968":{"id":"/release-notes-272","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b81--beta","content":"The native engine gets its introduction."},"969":{"id":"/release-notes-273","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b81--beta","content":"**A one-time card on macOS 27.** If your Mac can run Everpaper Native (the\nin-app engine b80 introduced), Everpaper now tells you so once, and offers\nto set everything up: it downloads the model, switches your provider, and\nproves a first response before saying done. Decline and nothing changes;\nthe option stays in Settings."},"970":{"id":"/release-notes-274","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b81--beta","content":"The setup survives closing the card — an accepted download keeps going in\nthe background."},"971":{"id":"/release-notes-275","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b81--beta","content":"On macOS 26 and earlier nothing appears; the card waits until the Mac can\nactually use it."},"972":{"id":"/release-notes-276","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b81--beta","content":"Requires macOS 14.2 or later, Apple Silicon. The Everpaper Native option\nadditionally requires the macOS 27 beta."},"973":{"id":"/release-notes-277","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80--beta","content":"The first build with an engine made only of Apple frameworks — no separate\nAI app required."},"974":{"id":"/release-notes-278","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80--beta","content":"**New intelligence option: Everpaper Native (macOS 27).** On Macs running\nthe macOS 27 beta, the provider picker gains an \"Everpaper Native\" row.\nChoosing it runs summaries, extraction, and chat through an engine bundled\nwith the app and built on Apple's frameworks — no LM Studio, no Ollama, no\nserver to install or keep running. On earlier macOS versions nothing changes\nand the row does not appear."},"975":{"id":"/release-notes-279","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80--beta","content":"The native engine ships with structured output built in (summaries and\naction items decode against a schema, not hopeful parsing) and streams its\nresponses."},"976":{"id":"/release-notes-280","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80--beta","content":"This beta's supported model is Qwen3-4B-Instruct-2507, prepared for Apple's\nruntime."},"977":{"id":"/release-notes-281","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80--beta","content":"Everything else — recording, transcription, journal — is unchanged from\nb79 and continues to use the existing engines regardless of this setting."},"978":{"id":"/release-notes-282","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b80--beta","content":"Requires macOS 14.2 or later, Apple Silicon. The Everpaper Native option\nadditionally requires the macOS 27 beta."},"979":{"id":"/release-notes-283","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b79--beta","content":"Same app as b78, rebuilt and signed on new hardware."},"980":{"id":"/release-notes-284","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b79--beta","content":"**No functional changes.** This build exists to move Everpaper's release process onto a new machine; everything listed under b78 is included and unchanged. If you are already running b78, there is nothing new to try."},"981":{"id":"/release-notes-285","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b79--beta","content":"Verified before release: notarized by Apple, signature and update-key checks passed, and the full test suite green."},"982":{"id":"/release-notes-286","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b79--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"983":{"id":"/release-notes-287","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b78--beta","content":"Pick your local AI model — or let Everpaper pick for your Mac."},"984":{"id":"/release-notes-288","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b78--beta","content":"**A model choice in first-run setup.** Under \"Set it up for me\", setup now names the model it will install and lets you change it. Every option shows its download size and how much memory it uses on a long meeting — not just the file size."},"985":{"id":"/release-notes-289","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b78--beta","content":"**The recommendation fits your hardware.** Everpaper reads this Mac's memory and only offers models it can actually hold alongside transcription. LFM2.5 2.6B stays the default everywhere; a faster lightweight option is always available, and Macs with 24 GB or more can pick a larger Qwen model for higher-quality summaries."},"986":{"id":"/release-notes-290","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b78--beta","content":"**Bigger models answer properly now.** The larger Qwen options had a habit of \"thinking out loud\" — pages of reasoning instead of the answer. Setup now configures them to answer directly."},"987":{"id":"/release-notes-291","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b78--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"988":{"id":"/release-notes-292","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b76--b77--beta","content":"Local AI setup gets a better brain, fitted to your Mac. The two builds are identical; b76 expires after 15 days, b77 never does."},"989":{"id":"/release-notes-293","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b76--b77--beta","content":"**A new starter model for the one-click local AI setup.** Choosing \"set it up for me\" now installs LFM2.5 2.6B — about half the download of the previous starter, faster on long transcripts, and tuned for exactly what this app asks of it: summarizing, extracting, and answering from your own recordings."},"990":{"id":"/release-notes-294","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b76--b77--beta","content":"**Lighter Macs get a lighter model.** On a MacBook Neo the setup installs a smaller, faster model instead, so summaries finish quickly on passive cooling."},"991":{"id":"/release-notes-295","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b76--b77--beta","content":"**Reasoning models stop thinking out loud.** Models that emit their scratch work before the answer no longer leak it into summaries and notes, whichever local server you use."},"992":{"id":"/release-notes-296","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b76--b77--beta","content":"Local AI setup now needs about 6 GB free instead of 10."},"993":{"id":"/release-notes-297","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b76--b77--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"994":{"id":"/release-notes-298","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b75--beta","content":"Settings opens instantly again."},"995":{"id":"/release-notes-299","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b75--beta","content":"**Opening Settings no longer freezes the app.** Since b72, opening Settings could pin the processor and beachball the whole app for ten seconds or more — on some Macs indefinitely. A bookkeeping write fired on every screen refresh while the page was open, and each write forced another refresh. The page now reads that record without touching it, and the loop is gone."},"996":{"id":"/release-notes-300","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b75--beta","content":"Nothing else changed in this build; it exists to get the fix out fast. The b74 improvements below are all included."},"997":{"id":"/release-notes-301","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b75--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"998":{"id":"/release-notes-302","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"The wait after a meeting stops being a mystery: what step, how long, and one click to the details."},"999":{"id":"/release-notes-303","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"**The pill is clickable now — in every state.** While a transcription runs, clicking the floating pill takes you straight to the Meetings page, where the working row shows the step, the percentage, and the time estimate. When it says \"Saved\", clicking opens the finished meeting. It used to swallow the click silently; right-click and VoiceOver now offer the same routes."},"1000":{"id":"/release-notes-304","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"**Every step has a name.** Preparing the audio, transcribing, separating speakers, saving — the pill, the meetings row, and the Today page now say which one is running. Before this build, only the transcription itself reported anything, so the bar could sit at 100% for minutes while real work happened in silence."},"1001":{"id":"/release-notes-305","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"**\"About 6 min left.\"** The transcription now estimates its remaining time from its own measured pace — shown in the meetings list, on the Today page, and during a re-analysis. It appears only once there is enough real progress to be honest, and disappears rather than guess."},"1002":{"id":"/release-notes-306","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"**The percentage no longer vanishes mid-way.** On a two-track recording the number used to disappear for minutes at the halfway mark; it now carries through."},"1003":{"id":"/release-notes-307","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"**A checkmark means done now.** The re-analysis view used to show its checkmark when the transcription finished, while speaker separation and saving were still running."},"1004":{"id":"/release-notes-308","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"**Smaller honesty fixes throughout.** The menu bar says \"Transcribing…\" instead of a disabled \"Stop Recording\"; an in-flight transcription no longer disappears from the list while you type in search; a long error message fits inside the pill instead of being cut off; and a rare stall in speaker separation can no longer hold a finished transcript hostage."},"1005":{"id":"/release-notes-309","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b74--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"1006":{"id":"/release-notes-310","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"A sweep through everything the app wasn't saying out loud."},"1007":{"id":"/release-notes-311","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"**Deleting a meeting can no longer half-delete it.** The audio was removed before the database entry, so a delete that failed partway left a meeting you could still see but never play. The order is reversed, and a failure now says so instead of pretending nothing happened."},"1008":{"id":"/release-notes-312","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"**A recording that dies mid-meeting says so.** If the microphone drops or the disk fills, the saved meeting now says it ended early — it used to report \"Saved\" exactly like a normal stop, leaving you to discover the missing forty minutes on your own."},"1009":{"id":"/release-notes-313","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"**The expired-beta message actually appears everywhere.** In b72, an expired build refused to start the day journal silently — the Start button just did nothing. It now explains itself there too, and Settings keeps saying a build has expired instead of going quiet at that exact moment. (This build does not expire.)"},"1010":{"id":"/release-notes-314","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"**Re-analysis shows its percentage on every engine.** The progress bar was still wired to the old assumption that only one engine could report."},"1011":{"id":"/release-notes-315","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"**The menu bar stops claiming \"Capturing\" during a meeting.** It now says \"Paused for meeting\", matching what the app actually does."},"1012":{"id":"/release-notes-316","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"**Quieter, more careful internals.** File names no longer land in the system log where a diagnostics bundle could carry them; the command-line tools run stored transcripts through the same credential-stripping pass as the app; deleting a day keeps its screenshots restorable for the full undo window; and several heavy list and audio operations got lighter."},"1013":{"id":"/release-notes-317","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b73--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"1014":{"id":"/release-notes-318","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b72--beta","content":"Progress you can see on every engine, and a beta that knows when to stop."},"1015":{"id":"/release-notes-319","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b72--beta","content":"**The other two transcription engines report their progress now.** Until this build only the advised meeting model showed a percentage; the standard pipeline — the one most people are on — spun with nothing to say for the whole wait. Both now count up, in the pill and in the meetings list. They report a plain percentage rather than naming the part of the recording being worked on, so it is coarser than the advised model, but it moves."},"1016":{"id":"/release-notes-320","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b72--beta","content":"**This beta stops recording after fifteen days.** A beta never updates itself, so an old copy would otherwise drift on forever, unsupported. When the date passes, Everpaper declines to start a *new* recording and points you at the current build."},"1017":{"id":"/release-notes-321","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b72--beta","content":"**Nothing is ever locked away.** An expired beta is read-only, not closed: your meetings, your days, search, and export all keep working exactly as before. The recordings on your Mac are yours, and no expiry touches them."},"1018":{"id":"/release-notes-322","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b72--beta","content":"**You get warned first.** Three days out, Settings opens with a line saying the build is about to stop recording, and a button that takes you to the current one."},"1019":{"id":"/release-notes-323","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b72--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"1020":{"id":"/release-notes-324","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b71--beta","content":"Recordings that finish themselves, and a wait you can watch."},"1021":{"id":"/release-notes-325","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b71--beta","content":"**A recording interrupted mid-transcript now finishes on its own.** If Everpaper is quit or killed while it is still writing a transcript, the audio was always safe — but finishing it meant knowing to open Meetings and press Recover. Everpaper now rebuilds it the next time you open the app, and tells you it did. When it decides not to, it says so rather than leaving you to find out."},"1022":{"id":"/release-notes-326","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b71--beta","content":"**It gives each recording one automatic try.** If rebuilding a particular recording is what stopped the app, Everpaper will not keep walking into that at every launch — that one waits for you to choose, and everything else still rebuilds on its own."},"1023":{"id":"/release-notes-327","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b71--beta","content":"**It stands aside for the work in front of you.** Automatic rebuilding never begins during a meeting, stops if you start one, and holds off while your Mac is in Low Power Mode."},"1024":{"id":"/release-notes-328","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b71--beta","content":"**The pill counts up.** After you stop a meeting, the floating pill now reads \"Transcribing… 47%\" instead of spinning with nothing to say. The percentage comes from the advised meeting model; the standard pipeline still shows a plain spinner."},"1025":{"id":"/release-notes-329","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b71--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"1026":{"id":"/release-notes-330","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b70--beta","content":"The meeting you just stopped no longer vanishes while it is written."},"1027":{"id":"/release-notes-331","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b70--beta","content":"**A meeting being transcribed appears in the list while it works.** Until it finished, a just-stopped meeting existed nowhere — not in Meetings, not in the Library — so a long transcription looked like nothing was happening at all. It now appears immediately, carrying its own progress, and becomes the finished meeting when it is done."},"1028":{"id":"/release-notes-332","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b70--beta","content":"**Described for what it is.** That entry reads \"Transcribing\", not \"Recovering\" — recovery wording is kept for a recording genuinely orphaned by a crash, so it still means something when you see it."},"1029":{"id":"/release-notes-333","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b70--beta","content":"**The day journal stops saying it is recording when it is not.** Screen capture pauses while a meeting records; the journal now says so, instead of showing \"Recording\" above a frame count that cannot move. Marking a moment still works throughout."},"1030":{"id":"/release-notes-334","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b70--beta","content":"**Capture that quietly fails is now visible.** A tick that captures frames but cannot store them, or a second display that stops producing frames, is reported rather than passing for healthy."},"1031":{"id":"/release-notes-335","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b70--beta","content":"**A long transcription reports its progress to the system log.** If one ever does get stuck, there is now a record that tells a working decode apart from a stalled one."},"1032":{"id":"/release-notes-336","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#200-b70--beta","content":"Requires macOS 14.2 or later, Apple Silicon."},"1033":{"id":"/release-notes-337","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"One model for meetings: words and voices together."},"1034":{"id":"/release-notes-338","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"**Meet MOSS, the new advised meeting model.** Until now, Hindsight transcribed meetings in two passes — one model wrote the words, a second worked out who spoke, and the two were stitched together afterwards. MOSS (MOSS-Transcribe-Diarize, Apache 2.0) does both at once: a single on-device model that transcribes and tells voices apart as it listens, so speaker changes land where sentences change hands. It is advised for meetings and entirely opt-in — about a 2 GB one-time download, and audio never leaves your Mac."},"1035":{"id":"/release-notes-339","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"**New users meet it during setup.** First-run setup gains a \"Tell Speakers Apart\" step: accept to download MOSS in the background while you keep walking through setup, or decline and keep the standard pipeline — nothing blocks, and you can change your mind later in Settings."},"1036":{"id":"/release-notes-340","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"**Existing users get one quiet announcement.** On first launch after updating, a single \"New in this impression\" notice explains the model and offers to set it up in place, with live download progress. Dismiss it and it never returns — a Press Check line and the new Meeting Model entry under Settings → Transcription & Speech remain the permanent path."},"1037":{"id":"/release-notes-341","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"**Switching back is one click.** \"Use instead\" returns meetings to the standard Parakeet pipeline at any time; the downloaded model is never deleted, and typing, dictation, and file transcription keep using Parakeet or Whisper exactly as before."},"1038":{"id":"/release-notes-342","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"**Long meetings stay light.** MOSS processes audio in ten-minute windows and stitches speakers across them, so memory stays flat (about 5 GB during finalization) no matter how long the meeting runs. The live meeting pane keeps its instant preview; the final pass after you stop is the authoritative transcript."},"1039":{"id":"/release-notes-343","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"**Honest edges.** Word-level timestamps inside a sentence are approximate with MOSS (segment boundaries are exact), and a voice that stays silent for a very long stretch may re-enter under a new speaker label. Raw and Clean Lexicon modes apply to MOSS transcripts exactly as they do everywhere else."},"1040":{"id":"/release-notes-344","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"**For the terminal.** `hindsight-cli transcribe --engine moss --diarize` runs the same joint model on any audio file."},"1041":{"id":"/release-notes-345","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1160","content":"Requires macOS 14.2 or later, Apple Silicon. The meeting model is happiest on 16 GB machines."},"1042":{"id":"/release-notes-346","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1151","content":"Raw now means raw for meetings too."},"1043":{"id":"/release-notes-347","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1151","content":"**Meeting transcripts honor the Lexicon mode.** Raw leaves recognized meeting wording untouched; Clean applies your Custom Words corrections during meeting finalization, crash recovery, and Re-analyze."},"1044":{"id":"/release-notes-348","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1151","content":"**Re-analyze stays consistent.** When you rerun transcription and speaker separation on a completed meeting, Hindsight uses the current Raw/Clean setting instead of silently applying corrections every time."},"1045":{"id":"/release-notes-349","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1151","content":"**The Lexicon is clearer.** The Processing mode copy now says it applies to both file transcriptions and meeting transcripts, and Custom Words are described as Clean-mode corrections."},"1046":{"id":"/release-notes-350","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1151","content":"Requires macOS 14.2 or later, Apple Silicon."},"1047":{"id":"/release-notes-351","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1150","content":"One click, one brain: setup can now install your local AI for you."},"1048":{"id":"/release-notes-352","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1150","content":"**Download & Set Up — and that's it.** If no local AI server is running, first-time setup now offers to do everything: it installs oMLX (a free, notarized inference server built for Apple Silicon), downloads the Qwen3.5 4B model (\\~4 GB) from Hugging Face with live progress, starts the server, and connects Hindsight the moment the model is ready. No account, no API key, no terminal — and nothing ever leaves your Mac."},"1049":{"id":"/release-notes-353","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1150","content":"**Interruption-proof.** A dropped connection doesn't restart the 4 GB download — setup resumes from the files that already finished. If oMLX's own first-run screen holds things up, Hindsight starts the server directly so setup still completes on its own."},"1050":{"id":"/release-notes-354","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1150","content":"**Your server, your choice.** Prefer LM Studio? One click opens its download page and Hindsight connects automatically as soon as its server appears. Already running Ollama, LM Studio, or oMLX? Setup finds it and connects with one click, exactly as before. And on Macs with Apple Intelligence available, there's a zero-download Connect that uses the on-device Apple model."},"1051":{"id":"/release-notes-355","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1150","content":"Requires macOS 14.2 or later, Apple Silicon."},"1052":{"id":"/release-notes-356","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1140","content":"First-time setup, rebuilt — the front door now matches the book behind it."},"1053":{"id":"/release-notes-357","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1140","content":"**Connect your intelligence during setup.** A new step finds a local AI server already running on your Mac (Ollama, LM Studio, oMLX) and connects it in one click — no key, no cloud, nothing leaves your machine. Recall, the Second Brain, and meeting prompts work from your very first day instead of waiting for a trip to Settings."},"1054":{"id":"/release-notes-358","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1140","content":"**The download no longer holds you hostage.** The speech model starts downloading the moment setup opens and keeps going while you walk the earlier steps — by the time you reach the models page it's often already done."},"1055":{"id":"/release-notes-359","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1140","content":"**Setup finally teaches the good keys.** The rehearsal now covers ⌥Space — your memory from anywhere on the Mac — alongside ⌘K, and the meetings step mentions ⌘⇧M for starting a recording from any app."},"1056":{"id":"/release-notes-360","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1140","content":"**Finish by starting.** The last page ends with a real \"Start Journaling\" press that begins today's record on the spot, plus an optional \"Open Hindsight at login\" so the daybook is running on the days that matter. And if macOS asks for a relaunch mid-setup, you now resume right where you left off instead of starting over."},"1057":{"id":"/release-notes-361","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1140","content":"**It moves like the book.** Steps turn like pages with a live progress rail, permissions flip to a green check with a small bounce the moment they land, and the whole flow quiets to simple fades when Reduce Motion is on."},"1058":{"id":"/release-notes-362","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1140","content":"Requires macOS 14.2 or later, Apple Silicon."},"1059":{"id":"/release-notes-363","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1130","content":"The Colophon learns to answer first: settings you can find, a health check that greets you, and one grammar for every control."},"1060":{"id":"/release-notes-364","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1130","content":"**The Press Check.** Settings now opens with its own health: anything unhealthy — microphone, screen recording, a failed AI test, a missing speech model — appears as one line with its one fix. When all is well, it says so in a single quiet line and stays out of the way."},"1061":{"id":"/release-notes-365","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1130","content":"**Find any setting, in place.** A permanent \"Find any setting…\" field lives in the pinned header (⌘F). Typing filters the page to matching settings — synonyms included, so \"mic\" finds Audio Input — and choosing one lands right on the row. Esc restores the page."},"1062":{"id":"/release-notes-366","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1130","content":"**Names you can guess.** Sections now lead with plain titles — Meetings, Transcription & Speech, Shortcuts & System, This Copy — with the book's own names kept as quiet subtitles beneath. \"Change my hotkey\" finally has an obvious home."},"1063":{"id":"/release-notes-367","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1130","content":"**One grammar for every control.** Actions that sit beside a status word are real buttons now (Test Input, Test Connection, Download), and Advanced settings live in a visibly inset group at the end of their section — no more guessing what's inside."},"1064":{"id":"/release-notes-368","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1130","content":"Requires macOS 14.2 or later, Apple Silicon."},"1065":{"id":"/release-notes-369","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1122","content":"The book finds its voice: reading type everywhere, and a calmer Today page."},"1066":{"id":"/release-notes-370","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1122","content":"**Prose is serif everywhere now.** The sidebar, Today's Focus, the Ask bar, chat copy, previews, empty states, and settings descriptions all read in the book's serif — the near-monospace face is retired to what it does best: timers, folios, stamps, and captured text."},"1067":{"id":"/release-notes-371","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1122","content":"**Start means start.** The day journal's Start button is now sized like the page's main action instead of a small chip under the feature list."},"1068":{"id":"/release-notes-372","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1122","content":"**A calmer Today.** One heading owns the page (the date), the journal card sits inside it, Today's Focus collapses to a slim strip when there's nothing to act on, and the Ask bar and its sample question read as one composed block."},"1069":{"id":"/release-notes-373","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1122","content":"Requires macOS 14.2 or later, Apple Silicon."},"1070":{"id":"/release-notes-374","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1121","content":"A polish release: reading comfort, tidier lists, and small consistency fixes across the book."},"1071":{"id":"/release-notes-375","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1121","content":"**Transcripts read like a page, not a terminal.** Meeting transcripts are now set in the book's serif at a comfortable reading width with proper line spacing — an hour-long conversation no longer renders as full-width monospace. Timestamps and speaker chips stay in the data register."},"1072":{"id":"/release-notes-376","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1121","content":"**Cleaner previews.** Archive cards preview their transcript in the reading face instead of monospace, and the feature notes on Today read as quiet prose instead of a settings list."},"1073":{"id":"/release-notes-377","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1121","content":"**Small consistency fixes.** The Library page now matches its sidebar name (\"The Archive\"), meeting dates share one format everywhere, date group headers match the app's eyebrow style, the engine status chip no longer fuses with the Import Transcript… button, and a meeting that lives on two calendars shows once in Upcoming instead of twice."},"1074":{"id":"/release-notes-378","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1121","content":"Requires macOS 14.2 or later, Apple Silicon."},"1075":{"id":"/release-notes-379","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1120","content":"The Concordance learns to hold a conversation — and recall gets sharper everywhere it looks."},"1076":{"id":"/release-notes-380","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1120","content":"**Follow up without re-asking.** Answers in the Concordance now build into a conversation: type the next question and the panel carries the thread with it. ⌘↵ still promotes the exchange into the Second Brain — now with its context attached, so a follow-up like \"did we set a deadline?\" survives the jump."},"1077":{"id":"/release-notes-381","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1120","content":"**\"What did I do on my last recorded day?\" answers.** Recall always anchors on your latest recorded days and meetings, so time-based questions get an answer even when they share no words with what was on screen."},"1078":{"id":"/release-notes-382","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1120","content":"**Long meetings answer from the right minute.** Recall now quotes the passage that actually matched — minute 40 of an hour-long meeting included — instead of only ever reading a meeting's opening minutes. Natural-language questions also match meetings and files far more reliably, and your indexed folders are searched by meaning, not just exact words."},"1079":{"id":"/release-notes-383","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1120","content":"**Transcript import, hardened.** Teams and Windows exports (CRLF line endings) import correctly, Zoom-style \"Name:\" speakers are recognized, timings survive so exporting an imported meeting as srt/vtt works, and big imports no longer freeze the app — the imported meeting opens for you when it's done."},"1080":{"id":"/release-notes-384","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1120","content":"Requires macOS 14.2 or later, Apple Silicon."},"1081":{"id":"/release-notes-385","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1110","content":"Concordance gets a real memory of your meetings, and outside transcripts can join your library."},"1082":{"id":"/release-notes-386","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1110","content":"**Concordance actually finds your meetings now.** Asking \"what did I talk about in my last meeting?\" used to come up empty — the AI answer only ever looked at your Days, never at meeting transcripts. It now grounds on meetings and indexed files too, with real semantic search over what was said, not just literal keyword matches."},"1083":{"id":"/release-notes-387","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1110","content":"**Import a transcript, get a meeting.** Have a .vtt transcript from Zoom, Teams, or Otter but no Hindsight recording? Meetings → Import Transcript… turns it into a real meeting — searchable and recallable just like one you recorded, no audio required."},"1084":{"id":"/release-notes-388","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1110","content":"Requires macOS 14.2 or later, Apple Silicon."},"1085":{"id":"/release-notes-389","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1100","content":"Meet the Concordance — your memory, one keystroke away, from anywhere on your Mac."},"1086":{"id":"/release-notes-390","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1100","content":"**Press ⌥Space anywhere.** A floating slip of the book appears over whatever you're doing — another app, another Space, even a full-screen call — without stealing focus from your work. Type to search your days, meetings, beliefs, and settings instantly; arrow keys and Return jump straight to the page in Hindsight."},"1087":{"id":"/release-notes-391","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1100","content":"**Ask without asking.** Pause typing for half a second and the Concordance starts recalling: an AI answer grounded in your captured days streams in right above the results. It's ephemeral — panel answers never clutter your Second Brain conversation. Press ⌘Return to continue the thought in the full app when it deserves a longer conversation."},"1088":{"id":"/release-notes-392","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1100","content":"**Scopes and files.** ⌘1–4 narrows to everything, days, meetings, or files. File matches search your indexed folders and reveal the document in Finder."},"1089":{"id":"/release-notes-393","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1100","content":"**Your shortcut, your call.** Rebind the summon in Settings → The Apparatus. (We default to ⌥Space rather than a global ⌘K on purpose — a system-wide ⌘K would silently eat the command palette in your editor, browser, and Slack. Inside Hindsight, ⌘K remains the Index.)"},"1090":{"id":"/release-notes-394","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1100","content":"Requires macOS 14.2 or later, Apple Silicon."},"1091":{"id":"/release-notes-395","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#191","content":"A quick fix on the heels of 1.9.0."},"1092":{"id":"/release-notes-396","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#191","content":"**Extract To-Dos works on any meeting.** Extracting to-dos from a transcript silently did nothing for meetings older than three days — a Today-rail recency rule had leaked into the explicit action. It now works regardless of age, tells you the outcome (\"3 to-dos added to Today.\" or an honest none-found note), and re-extracting resurfaces to-dos you'd previously exported or dismissed instead of silently skipping them."},"1093":{"id":"/release-notes-397","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#191","content":"Requires macOS 14.2 or later, Apple Silicon."},"1094":{"id":"/release-notes-398","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"A design release. Every page got a pass from an expert review of the whole interface — smarter suggestions, honest insights, readable type, and dozens of paper cuts gone."},"1095":{"id":"/release-notes-399","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"**Suggestions you can trust.** Tell Hindsight your email addresses (Settings → Second Brain) and it stops mistaking your own name for a person to track — no more \"assess your own relevance\" suggestions. Speculative observations can't become Apple Reminders anymore, websites and people no longer masquerade as tasks, and the same insight stops appearing twice in different words."},"1096":{"id":"/release-notes-400","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"**A quieter, sharper Second Brain.** The You tab rolls websites up to the site (not every page), caps the lists, and speaks to you — no more raw tags, enum names, or numbered leftovers. Chat now owns its tab with one scroll instead of a scroll-inside-a-scroll, and duplicated model answers collapse automatically."},"1097":{"id":"/release-notes-401","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"**Meetings name themselves.** A finished recording takes its title from the overlapping calendar event — no more walls of \"Meeting 23 Jun at 18:37\". Rapid-fire crosstalk renders compactly, phantom \"speakers\" with five words step out of the speaker list, transcript previews read like sentences, prompts show as runnable actions and replace their old results instead of stacking duplicates."},"1098":{"id":"/release-notes-402","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"**Days that read like a day.** Timeline entries describe what was actually on screen (never keyword soup), quick message-checking hops fold into one \"Checking messages\" row, and a new MARGINALIA column surfaces the day's open questions and loose ends — only when there are any, and never invented."},"1099":{"id":"/release-notes-403","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"**Easier on the eyes.** Long AI answers now read in the book's serif with proper line spacing instead of typewriter-style text, numbered lists align properly everywhere, and the Archive gained date groups, clickable favorite stars, a clearer filter bar, and word-by-word search."},"1100":{"id":"/release-notes-404","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"**Settings you can navigate.** The section index stays pinned while you scroll, ⌘F hint included; destructive actions look like the buttons they are; and the Lexicon finally dresses like the rest of the book."},"1101":{"id":"/release-notes-405","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#190","content":"Requires macOS 14.2 or later, Apple Silicon."},"1102":{"id":"/release-notes-406","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#182","content":"A quick follow-up to the file-indexing rework: live status you can actually watch, and proper patience with local AI models that are still loading."},"1103":{"id":"/release-notes-407","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#182","content":"**Indexing shows its work again.** The progress bar appears the moment indexing starts — no more long silent stretch on a fresh index — and a live status line tells you exactly what's happening: \"Reading files…\", \"Splitting files by meaning…\", \"Embedding chunks (batch 2/7)…\". Pause and Cancel are always visible while a run is active, and pausing now takes effect mid-run instead of waiting for the current batch of files to finish."},"1104":{"id":"/release-notes-408","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#182","content":"**Cold models are waited for, not skipped.** If your local AI server is still loading a model when indexing starts, Hindsight now waits for it — retrying for a couple of minutes with a \"Waiting for the embedding model to load…\" status — instead of silently falling back to the weaker built-in embedder for the whole run. Meaning-aware chunking gets the same fix: a model that takes more than a minute to load no longer loses semantic splitting for every file."},"1105":{"id":"/release-notes-409","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#182","content":"Requires macOS 14.2 or later, Apple Silicon."},"1106":{"id":"/release-notes-410","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#181","content":"A focused reliability release for reminders — the Today rail's suggested to-dos and calendar meeting alerts."},"1107":{"id":"/release-notes-411","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#181","content":"**\"Add to Reminders\" works now.** Exporting your to-dos to Apple Reminders crashed the app the moment macOS asked for permission — a packaging bug, fixed and now guarded by a test. If access is denied, Hindsight explains why and offers an Open System Settings shortcut instead of failing silently."},"1108":{"id":"/release-notes-412","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#181","content":"**Suggested to-dos you can trust.** AI-extracted tasks are now checked against the meeting or screen text they claim to come from — an invented task never reaches the rail or your Reminders. Rephrased titles that drift from the original task fall back to the plain version, owner-style items (\"Jane: send the brief\") are picked up, and filler lines (\"None\", \"No action items identified\") no longer become to-dos."},"1109":{"id":"/release-notes-413","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#181","content":"**Dismissed means dismissed.** To-dos you dismiss, complete, or export stay gone across relaunches — and a suppression quietly expires after a month, so a recurring task with the same name isn't hidden forever."},"1110":{"id":"/release-notes-414","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#181","content":"**Meeting alerts actually arrive.** Reminders now show as banners while Hindsight is the frontmost app (they were silently suppressed before), a Mac that slept through the reminder window still alerts you on wake while the meeting is joinable — with honest timing (\"starts in 2 minutes\" / \"has started\") — and declining notification permission no longer switches the whole calendar feature off."},"1111":{"id":"/release-notes-415","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#181","content":"**Fresher suggestions.** Meeting action items older than a week stop resurfacing on Today as if they were new."},"1112":{"id":"/release-notes-416","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#181","content":"Requires macOS 14.2 or later, Apple Silicon."},"1113":{"id":"/release-notes-417","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#180","content":"File indexing got a ground-up rework — dramatically faster and easier on your Mac — and your indexed files now back up the Second Brain's answers directly."},"1114":{"id":"/release-notes-418","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#180","content":"**File indexing is fast now.** Folders index in parallel waves instead of one file at a time, re-indexing an unchanged folder finishes in seconds with zero wasted work, and a single huge file can no longer stall the run. On machines running a local AI, indexing also stops swapping models back and forth for every file — the biggest source of slowdown."},"1115":{"id":"/release-notes-419","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#180","content":"**Answers cite your files.** Ask the Second Brain something that lives in an indexed folder and the answer now draws on those files, with \\[file:n] citations pointing at the exact file and lines it used."},"1116":{"id":"/release-notes-420","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#180","content":"**Snappier everywhere.** Sending a question paints instantly instead of waiting on retrieval, the Second Brain tab opens without a hitch, and recall, day chats, and the Days list no longer block the interface while they read the journal."},"1117":{"id":"/release-notes-421","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#180","content":"**Retention that means it.** A new toggle — \"Also delete their text & recall data\" — makes the retention setting remove expired captures' text, search index, and recall entities too, so old data truly expires and the database stays bounded. It's on for new installs; existing journals keep their history unless you opt in. Cleanup now also runs daily, not just when a session starts."},"1118":{"id":"/release-notes-422","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#180","content":"**Meetings, tightened.** Stereo playback now lines up with the transcript timeline, and the live preview cuts at natural speech pauses instead of mid-word. Plus a batch of fixes: the AI vision-descriptions toggle actually works now, importing from the legacy app no longer freezes the window, and chat vs. embeddings API keys no longer overwrite each other."},"1119":{"id":"/release-notes-423","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#180","content":"Requires macOS 14.2 or later, Apple Silicon."},"1120":{"id":"/release-notes-424","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#170","content":"Export your meeting transcripts, get real speakers out of single-microphone recordings, and watch — and pause — file indexing while it runs."},"1121":{"id":"/release-notes-425","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#170","content":"**Export any transcript.** Save a meeting's transcript to a file — plain text, Markdown, subtitles (SRT or VTT), or JSON — from the new Export button on the meeting, or \"Save Transcript…\" in the Library's right-click menu. Everything is written locally to a file you choose; nothing is uploaded."},"1122":{"id":"/release-notes-426","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#170","content":"**Single-microphone recordings get real speakers.** A meeting captured from a single audio source — just your microphone, or one where the system audio dropped partway through — used to collapse into one speaker labelled \"Me\". Now Hindsight splits it into separate speakers whenever it hears more than one voice, while a genuine solo recording still reads as \"Me\". Re-analyzing an existing meeting picks this up too."},"1123":{"id":"/release-notes-427","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#170","content":"**See — and pause — file indexing.** Indexing a folder now shows a real progress bar (files done out of the total) instead of an open-ended spinner, and you can pause a long index and resume it later from where it left off. Pausing never leaves a half-built index behind."},"1124":{"id":"/release-notes-428","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#170","content":"Requires macOS 14.2 or later, Apple Silicon."},"1125":{"id":"/release-notes-429","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"A more AI-driven Second Brain — pick your own embedding model, smarter suggested to-dos, and meaning-aware file indexing — plus a wave of reliability fixes across reminders, your days, and the Second Brain."},"1126":{"id":"/release-notes-430","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"**Choose your embedding model — and it's used everywhere.** The embedding model you pick for Folder Context RAG now drives *both* indexing and search, so your files and your queries are always embedded with the same model (a mismatch used to silently break semantic search). Point it at a local model in Ollama, LM Studio, or oMLX and nothing leaves your Mac; a cloud embedding model only ever receives your file text if you explicitly choose one and grant consent."},"1127":{"id":"/release-notes-431","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"**Smarter suggested to-dos.** Today's task suggestions are rephrased into natural, imperative tasks; meeting action items are extracted by the model from the meeting text; and tasks you pull from a specific meeting now stay on the rail when the page refreshes. Each step falls back to the built-in, on-device behavior when no model is connected."},"1128":{"id":"/release-notes-432","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"**Meaning-aware file chunking.** With a local model configured, files are split into sections by meaning instead of by paragraph or page, so retrieval lands on coherent passages — and it falls back cleanly to structural chunking otherwise. PDFs and spreadsheets keep their page-accurate citations."},"1129":{"id":"/release-notes-433","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"**File search actually uses your vectors.** Semantic file search now runs whenever you've typed a query (multi-word queries used to silently drop to keyword-only), re-indexes only the files that changed instead of re-embedding the whole folder every time, can be cancelled mid-run, and tells you when a folder has nothing to index."},"1130":{"id":"/release-notes-434","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"**Reminders that behave.** \"Add to Reminders\" confirms when it worked, won't pile up duplicates, and writes the whole list in one pass — and an imminent meeting's reminder is no longer dropped when notification permission was still warming up."},"1131":{"id":"/release-notes-435","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"**Faster, more honest day pages.** Opening a day no longer hitches the interface, screenshots use far less memory, the timeline shows the whole day (not just the first stretch of it), per-app time and on-disk storage are reported accurately, and deleting a day takes a single confirmation."},"1132":{"id":"/release-notes-436","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"**A steadier Second Brain.** Beliefs no longer fade away prematurely, so your self-model and persona stay populated; chat citations resolve to the right frames after you reopen a conversation; and the self-model keeps updating even in Low Power Mode."},"1133":{"id":"/release-notes-437","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#160","content":"Requires macOS 14.2 or later, Apple Silicon."},"1134":{"id":"/release-notes-438","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#152","content":"Debugging tools for the embeddings provider — so you can tell when your model isn't loaded and fix it without reading server logs."},"1135":{"id":"/release-notes-439","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#152","content":"**Test Connection for embeddings.** The embeddings provider card now has a \"Test Connection\" button (just like the chat AI). It sends a tiny embed request to your configured endpoint and tells you whether it worked — including the served model and vector dimensions — or shows the exact error. No more guessing whether your model is loaded or the name is right."},"1136":{"id":"/release-notes-440","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#152","content":"**Diagnostic logging.** The embeddings path now logs to Console.app (subsystem `com.iannellomarco.hindsight.core`, category `Embeddings` + `FileIndexer`). You can see exactly what model was requested, whether it succeeded, and when the app fell back to the on-device model — filter Console by the subsystem and send the logs when something's off."},"1137":{"id":"/release-notes-441","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#152","content":"Requires macOS 14.2 or later, Apple Silicon."},"1138":{"id":"/release-notes-442","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#151","content":"A dedicated embeddings model picker for Folder Context RAG — and three fixes the adversarial code review caught before they reached you."},"1139":{"id":"/release-notes-443","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#151","content":"**Pick your embeddings model.** Folder Context RAG now has its own provider config in Settings → Intelligence → File Index, parallel to your chat AI. Point it at Harrier OSS v1 0.6B (or any embedding model) in your Ollama, LM Studio, or oMLX instance — independent of your chat model. A refresh-from-provider list helps you pick. With none set, files use the on-device model."},"1140":{"id":"/release-notes-444","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#151","content":"**Saves take effect immediately.** Configuring the embeddings model used to require an app relaunch (a stale-capture bug froze the old config). Now the index and retrieval read the live setting on every call — change the model, hit re-index, and it's used right away."},"1141":{"id":"/release-notes-445","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#151","content":"**File content never leaves your Mac.** The fallback path that used your chat AI for embeddings is now gated to local providers only — a cloud chat provider will never receive your file text for embedding."},"1142":{"id":"/release-notes-446","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#151","content":"**Retrieval uses the right model.** A matching fix ensures the query vectors and the indexed vectors come from the same model, so semantic search actually works (it was silently mismatched before)."},"1143":{"id":"/release-notes-447","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#151","content":"Requires macOS 14.2 or later, Apple Silicon. We recommend Harrier OSS v1 0.6B (the MLX 8-bit build) in your Ollama or LM Studio instance for file embeddings."},"1144":{"id":"/release-notes-448","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"Your Second Brain now leads with genuine AI insight, reads your own files, and works reliably on local models — all on-device, all private."},"1145":{"id":"/release-notes-449","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"**The page now leads with what the AI actually did.** The Second Brain used to open with templated counting (\"X sits at the center of a lot of what you do\", cycling a few phrases). Now the AI Reflection — grounded observations written from your real captured moments — leads the page, and the templated belief cards are rephrased into varied, specific observations by the model. The vanity stat row is gone. With no AI connected, you get an honest \"connect a model\" prompt instead of fake templated confidence."},"1146":{"id":"/release-notes-450","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"**Your Second Brain can now read your files.** Point Hindsight at a workspace folder — a repo, a docs folder, a papers folder — and it indexes everything inside on your Mac: code, markdown, PDFs, images (via OCR), spreadsheets, rich text, email. The Reflection can then connect your screen activity to your own work artifacts, cited by file. \"You switched to Slack right after the compile errors your plan flagged.\" Nothing leaves your Mac; embeddings run on your local model."},"1147":{"id":"/release-notes-451","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"**Local AI is now reliable enough to be the primary brain.** Hindsight now asks your local model (Ollama, LM Studio, oMLX) for structured JSON output instead of prompting and hoping — the change that makes a 3–8B local model dependable as your main Second Brain, not a fallback. Cloud stays optional and opt-in."},"1148":{"id":"/release-notes-452","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"**The Reflection checks itself, and sees the right frames.** Every reflection is now verified against your actual captured data before it sticks — a fabricated name paired with a real citation gets stripped. And it retrieves semantically-relevant frames (not just the most recent ones), so a reflection about \"the migration\" pulls migration moments from across the week."},"1149":{"id":"/release-notes-453","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"Today's Focus is sharper and lands in Reminders:"},"1150":{"id":"/release-notes-454","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"**Cleaner, more useful todos.** Citation markers and raw URLs/IPs no longer leak into your todo titles, and machine-internal detail text is replaced with human guidance. A tighter, higher-quality list."},"1151":{"id":"/release-notes-455","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"**Send to Reminders, not Notes.** The export now creates one checkable reminder per todo in a \"Hindsight\" list — native checklist, individually completable, syncs to your iPhone. Action items belong in Reminders."},"1152":{"id":"/release-notes-456","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#150","content":"Requires macOS 14.2 or later, Apple Silicon. Folder Context RAG and the local-AI improvements work best with a local embedding model (we recommend Harrier OSS v1 0.6B, the MLX 8-bit build, in your Ollama or LM Studio instance) — but everything degrades gracefully to the on-device model when none is running."},"1153":{"id":"/release-notes-457","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#141","content":"Today's Focus is now smarter, always visible, and reachable from every meeting."},"1154":{"id":"/release-notes-458","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#141","content":"**Extract Todos from any meeting.** A new checklist button in the meeting detail reads the transcript and pulls out the action items — things you said you'd do, were asked to do, or agreed to. They land in Today's Focus immediately, each tagged with the meeting it came from."},"1155":{"id":"/release-notes-459","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#141","content":"**Todos from real content, not just patterns.** When an AI provider is connected, Today's Focus now reads the actual text of your meeting transcripts and on-screen captures — not just the statistics — and extracts specific, actionable tasks (\"Send the brief to Jane by Friday\") instead of pattern inferences (\"You haven't touched plan.md in 8 days\")."},"1156":{"id":"/release-notes-460","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#141","content":"**Always-visible, always-refreshable.** The Today's Focus rail is now always on screen — even when empty, it shows what to do to surface tasks. A refresh button lets you regenerate on demand."},"1157":{"id":"/release-notes-461","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#141","content":"**Auto-extract after meetings.** When a meeting finishes, its action items are extracted automatically — you don't have to do anything."},"1158":{"id":"/release-notes-462","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#141","content":"Requires macOS 14.2 or later, Apple Silicon."},"1159":{"id":"/release-notes-463","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"Your Second Brain now genuinely thinks about your work — and the whole app got sharper, more honest, and more consistent."},"1160":{"id":"/release-notes-464","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"**The Reflection.** After you finish a day (or when you open Hindsight in the morning), your Second Brain reads the actual moments it captured — not just the counts, but what was on your screen, in what order, at what time — and writes a short Reflection: two or three genuine observations a thoughtful colleague might make. Every claim points back to the specific moments it noticed it in. It runs on your Mac if you use Apple Foundation Models or Ollama — free, private, no cloud needed."},"1161":{"id":"/release-notes-465","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"**A self-model that develops over time.** The Reflection's observations now become lasting beliefs. When the same pattern recurs across days, it firms up; when it doesn't, it fades. Recurring patterns promote to stable traits, and those traits shape what the Second Brain notices next — so its understanding deepens, not just accumulates."},"1162":{"id":"/release-notes-466","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"**The story of becoming.** The \"Who you are\" card on the You tab now tells a narrative — what the Second Brain has come to understand about you, how that's changed recently, and where it sees tension."},"1163":{"id":"/release-notes-467","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"**Today's Focus.** A new panel on Today surfaces suggested to-dos from your patterns — files you opened then dropped, topics that faded, action items from meetings. Check one off, dismiss it, or send the whole list to Apple Notes with one click."},"1164":{"id":"/release-notes-468","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"**Hide your voice from transcripts.** A one-click \"Hide my voice\" toggle on any meeting transcript. Your turns disappear from the view, but nothing is destroyed — bring them back anytime. It survives re-analysis too."},"1165":{"id":"/release-notes-469","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"Trust and privacy hardening:"},"1166":{"id":"/release-notes-470","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"**Every answer is now verified.** The Second Brain's honesty guard — which strips any claim it can't ground in your actual captured data — now runs on every chat answer, not just the relational ones."},"1167":{"id":"/release-notes-471","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"**Settings you can trust.** Three toggles that promised behavior but never actually did anything have been fixed or removed. The cloud-consent controls are now one clear decision instead of three cross-referencing toggles."},"1168":{"id":"/release-notes-472","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"Plus: the Apple Notes Automation entitlement for one-click todo export, LLM-assisted phrasing of suggested to-dos when a provider is connected, meeting action items flowing into the Today's Focus rail, and dozens of accessibility improvements."},"1169":{"id":"/release-notes-473","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#140","content":"Requires macOS 14.2 or later, Apple Silicon."},"1170":{"id":"/release-notes-474","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#131","content":"A smarter privacy boundary for on-device AI — and a more consistent feel throughout."},"1171":{"id":"/release-notes-475","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#131","content":"**Local AI now grounds on the real thing.** When you use an on-device provider (Ollama, Apple Foundation Models, or LM Studio), Hindsight no longer strips contact details from what the model sees — names, emails, and phone numbers are preserved so your Second Brain and chat answers reference real people and projects instead of `[REDACTED:name]`. Nothing leaves your Mac, so there's no privacy cost. Secrets (cards, keys, tokens) are still scrubbed for every provider."},"1172":{"id":"/release-notes-476","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#131","content":"**Meeting chat speaks up when it fails.** A question to a meeting that can't reach the AI provider now shows the reason inline, instead of going silent or leaving a placeholder message behind."},"1173":{"id":"/release-notes-477","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#131","content":"**One Send, everywhere.** The ask boxes in the meeting panel, meeting detail, and journal chats now share the same look and the same Send control — a consistent composer across the whole app."},"1174":{"id":"/release-notes-478","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#131","content":"**Keyboard tabs in meetings.** Switch a meeting's Transcript / Results / Chat / Speakers with `⌘1`–`⌘4`, matching the rest of the app."},"1175":{"id":"/release-notes-479","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#131","content":"Plus the usual polish: standardized section headings and spacing, a centered empty state on Meetings, and sharper accessibility labels."},"1176":{"id":"/release-notes-480","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"Find any day in your history at a glance, and never lose one to an accidental delete."},"1177":{"id":"/release-notes-481","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"**The Day Index.** Press `⌘L` anywhere to open a chronological overview of every captured day — title, date, and a thumbnail for each, with a density strip showing how much history you've built. Use `↑↓` to move and `Return` to turn straight to a day."},"1178":{"id":"/release-notes-482","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"**Recoverable deletions.** Deleting a day now removes it from the book but offers an *Undo* right after, from Today — so a mistake never costs you a captured day."},"1179":{"id":"/release-notes-483","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"**Always-on sidebar.** The book's Parts are visible by default on launch; unpin from the masthead toggle if you'd rather have the room."},"1180":{"id":"/release-notes-484","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"**Richer timeline.** Every activity row now shows a thumbnail you can click to open full-size — not just the starred moments."},"1181":{"id":"/release-notes-485","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"A real privacy hardening for AI vision:"},"1182":{"id":"/release-notes-486","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"**Secret-bearing frames never leave your Mac.** If a screenshot's captured text revealed a card, key, or token, its pixels are no longer sent to a vision provider — the text redactor can't see into the image, so the whole frame is withheld."},"1183":{"id":"/release-notes-487","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"**Honest about what vision sees.** The vision setting and the on-day redaction badge now say plainly: captured text is scrubbed, but visible pixels sent for descriptions are not."},"1184":{"id":"/release-notes-488","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#130","content":"And a sweep of reliability and polish: the recording control no longer lets *Discard* look like the main action; a failed Second Brain question now tells you instead of hanging; the \"relaunch to apply Screen Recording\" state stays visible until you act on it; a new multi-step progress bar in setup; and consistent ask fields, status dots, and delete confirmations throughout."},"1185":{"id":"/release-notes-489","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"The Second Brain now answers from what your screens actually showed — not just who and\nwhat kept recurring."},"1186":{"id":"/release-notes-490","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"**Answers from real content.** Ask \"why do I keep working with this client?\" and the chat reads\nthe actual text of the relevant moments — emails, docs, messages — and grounds its answer\nin them, with citations you can click to jump straight to the frame."},"1187":{"id":"/release-notes-491","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"**It knows you're not your own coworker.** The Second Brain no longer lists you among the\npeople you work with."},"1188":{"id":"/release-notes-492","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"**Tighter privacy at the edge.** When a cloud model is in use, email addresses and phone\nnumbers are scrubbed from what's sent — on top of the existing secret redaction."},"1189":{"id":"/release-notes-493","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"The Days page is also redesigned:"},"1190":{"id":"/release-notes-494","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"**A sidebar for the book.** An always-available table of contents. It auto-hides to give\nthe page room — hover the left edge to peek it open — or pin it from the toggle in the top-left."},"1191":{"id":"/release-notes-495","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"**Timeline previews.** Each moment in a day's timeline now shows a thumbnail you can click\nto open full-size."},"1192":{"id":"/release-notes-496","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#120","content":"A bigger delete control, and clearer labels distinguishing asking the whole book from\nchatting with a single day."},"1193":{"id":"/release-notes-497","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#111","content":"Two fixes to the Second Brain."},"1194":{"id":"/release-notes-498","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#111","content":"**Dismiss sticks.** When you dismiss something the Second Brain inferred about you, it\nno longer quietly comes back the next day."},"1195":{"id":"/release-notes-499","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#111","content":"**Sharper recall.** Asking about a specific person or file now surfaces the right ones\nto jump to, instead of coming up empty on a normally-worded question."},"1196":{"id":"/release-notes-500","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#110","content":"Your Second Brain now understands *you* — not just the people, files, and projects in\nyour work, but who you are and how your days have been going."},"1197":{"id":"/release-notes-501","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#110","content":"**It knows you.** Tell it your name and role (during setup, or anytime in Settings) and\nit speaks to you personally — greeting you by name and writing your day as someone it\nactually knows."},"1198":{"id":"/release-notes-502","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#110","content":"**It learns you.** From your own days it quietly works out things like your role, the\nway you work, and how you've been feeling — and asks you to confirm the important guesses\nbefore trusting them. Nothing is assumed, and anything that feels off is one tap to dismiss."},"1199":{"id":"/release-notes-503","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#110","content":"**A new \"You\" tab.** A home for your profile: a short portrait of who you are, the traits\nit has noticed, and a timeline of how your days have felt."},"1200":{"id":"/release-notes-504","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#110","content":"**Private by default.** All of this stays on your Mac and works with on-device AI. Sharing\nyour profile with a cloud provider takes a separate, explicit opt-in."},"1201":{"id":"/release-notes-505","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1012","content":"A broad polish pass: more reliable meeting status, far wider accessibility, and a\nfaster, more consistent interface."},"1202":{"id":"/release-notes-506","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1012","content":"**Meeting status updates instantly.** The menu-bar recording glyph, the permission\nprompt when a recording is blocked, and the \"transcribing…\" indicator now reflect\nwhat's happening the moment it changes."},"1203":{"id":"/release-notes-507","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1012","content":"**Much better VoiceOver support.** Buttons and controls across the app — Meetings,\nthe Day Journal, the Second Brain, onboarding, and the Index — now announce\nmeaningful names, and secondary text meets WCAG AA contrast."},"1204":{"id":"/release-notes-508","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1012","content":"**Snappier reading.** Opening a finished day, searching the Index, and reading\nstreamed answers are all faster and smoother."},"1205":{"id":"/release-notes-509","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1012","content":"**Clearer meetings.** The section is consistently called \"Meetings\", larger calls\nget more distinct speaker colors, the connect-calendar prompt refreshes after you\ngrant access, and a failed prompt now shows an error instead of doing nothing."},"1206":{"id":"/release-notes-510","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1012","content":"**Rebindable meeting hotkey.** The global start/stop shortcut (default ⌘⇧M) can now\nbe changed in Settings → The Minutes."},"1207":{"id":"/release-notes-511","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1012","content":"**Smaller fixes.** Onboarding scrolls on small displays, the meeting audio player\nresets at the end of a clip, deleting a custom word asks first, and a failed app\nsummary can be retried."},"1208":{"id":"/release-notes-512","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1011","content":"A fix so a finished day always shows up where you expect it."},"1209":{"id":"/release-notes-513","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1011","content":"**New days appear right away.** After you stop and save a day, it now shows up\non the Days page immediately — previously a freshly finished day could stay\nhidden there until you quit and reopened the app."},"1210":{"id":"/release-notes-514","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1010","content":"Much better speaker detection, plus new ways to fix up a meeting after it's\nrecorded."},"1211":{"id":"/release-notes-515","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1010","content":"**Far better speaker separation.** A one-on-one call is no longer split into a\nhandful of phantom speakers, and genuine group meetings keep everyone — the\nspeaker count is no longer capped, so a large call isn't truncated down to a\nfew voices."},"1212":{"id":"/release-notes-516","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1010","content":"**Re-analyze a meeting.** A new button on a saved meeting re-runs transcription\nand speaker detection on the original audio — so you can pick up these speaker\nimprovements on meetings recorded earlier, without recording again."},"1213":{"id":"/release-notes-517","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1010","content":"**Rename a meeting.** A pencil next to the title renames a meeting at any time."},"1214":{"id":"/release-notes-518","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1010","content":"**Name a meeting from your calendar.** One click names a meeting after the\ncalendar event it overlaps, so your recordings match your schedule."},"1215":{"id":"/release-notes-519","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#1010","content":"**Refreshed meeting tabs.** The Transcript / Results / Chat / Speakers tabs now\nuse the same thumb-tab style as the rest of the app."},"1216":{"id":"/release-notes-520","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#109","content":"A formatting hotfix for AI answers."},"1217":{"id":"/release-notes-521","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#109","content":"**AI answers are now formatted.** Responses from Ask, the Second Brain, and\nmeeting Q\\&A render their Markdown — bold, italic, headings, and bullet lists —\ninstead of showing raw \"\\*\\*\" and \"\\*\" characters."},"1218":{"id":"/release-notes-522","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#108","content":"Fixes meeting transcription."},"1219":{"id":"/release-notes-523","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#108","content":"**Transcription no longer freezes.** A scheduling deadlock could leave the live\ntranscript blank during a meeting and the post-recording \"transcribing…\" step\nstuck indefinitely. Recording and transcription now run on separate lanes — the\nlive transcript fills in during the meeting and the final transcript completes\npromptly."},"1220":{"id":"/release-notes-524","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#108","content":"**More accurate speakers.** Tightened speaker separation so a single remote\nparticipant is no longer occasionally split into two, and a slow\nspeaker-detection step no longer holds up the final transcript."},"1221":{"id":"/release-notes-525","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#107","content":"Clearer day navigation."},"1222":{"id":"/release-notes-526","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#107","content":"**Visible page controls.** The Days page now has previous / next buttons and a\ndotted day indicator beneath it — one dot per day, with the current day\nhighlighted. Click any dot to jump straight to that day. (The page-turn\ncontrols were previously invisible edge zones.)"},"1223":{"id":"/release-notes-527","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#106","content":"Turning the pages — fixed, and nicer."},"1224":{"id":"/release-notes-528","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#106","content":"**Day navigation works again.** The left/right arrow keys (and ⌘\\[ / ⌘]) turn\nbetween days without having to click the page first, and the optional\ntwo-finger swipe (Colophon → \"Turn pages with a two-finger swipe\") is reliable."},"1225":{"id":"/release-notes-529","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#106","content":"**A page-peel turn.** Days now turn with a subtle page-peel animation instead\nof a flat slide. Honors Reduce Motion."},"1226":{"id":"/release-notes-530","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#106","content":"**New app icon.** A Daybook cover with the rubric-red ribbon bookmark."},"1227":{"id":"/release-notes-531","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#105","content":"Meeting recording now starts instantly."},"1228":{"id":"/release-notes-532","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#105","content":"**No more waiting to record.** Previously, starting a meeting could pause on\n\"Preparing speech model…\" while the on-device model loaded. Now recording\nbegins immediately and captures audio from the first second; the speech model\nloads in the background."},"1229":{"id":"/release-notes-533","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#105","content":"**Visible transcription progress.** While the model loads, the transcript area\nshows a progress bar instead of a frozen screen, and the transcript fills in as\nsoon as the model is ready. The full meeting is always transcribed when you\nstop."},"1230":{"id":"/release-notes-534","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#104","content":"A reliability release for meeting recording — especially your first one after\ninstalling."},"1231":{"id":"/release-notes-535","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#104","content":"**Meetings wait for the speech model.** If you start recording before the\non-device speech model has finished its one-time setup, Hindsight now shows\n\"Preparing speech model…\" and begins once it's ready, instead of recording a\nmeeting that comes back with an empty transcript."},"1232":{"id":"/release-notes-536","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#104","content":"**A more responsive Mac while recording.** Day Journal capture pauses for the\nduration of a meeting, so screen capture and live transcription no longer\ncompete for the Neural Engine — and it resumes automatically when the meeting\nends."},"1233":{"id":"/release-notes-537","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#103","content":"A small reliability release for first-run setup."},"1234":{"id":"/release-notes-538","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#103","content":"**Clearer Screen Recording setup.** When Hindsight is opened from outside your\nApplications folder — where macOS runs it from a temporary, locked-down copy —\nsetup now tells you to move Hindsight to Applications and reopen it, which is\nthe only way the Screen Recording permission will stick. Previously it pointed\nyou at the \"+\" button, which can't take effect in that case."},"1235":{"id":"/release-notes-539","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#103","content":"**Sturdier packaging.** The disk image is now signed unambiguously, and the\ndiagnostics behind the Screen Recording grant were tightened so first-run\nsetup issues are easier to trace."},"1236":{"id":"/release-notes-540","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#103","content":"No feature changes — everything in 1.0.0 below is unchanged."},"1237":{"id":"/release-notes-541","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#102","content":"**Fixed a launch crash on some Macs.** The bundled Daybook fonts failed to\nload on Macs other than the one the app was built on, which could crash\nHindsight at startup. Fonts now load reliably on every Mac."},"1238":{"id":"/release-notes-542","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#102","content":"**Smoother Screen Recording grant.** After you allow Screen Recording, setup\nnow shows a clear **Relaunch Hindsight** step — macOS only applies this\npermission to a freshly launched app, so the relaunch is what makes the grant\ntake effect."},"1239":{"id":"/release-notes-543","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#101","content":"A packaging release focused on a smoother, more reliable first launch."},"1240":{"id":"/release-notes-544","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#101","content":"**Notarized and stapled.** The app is signed, notarized by Apple, and the\nnotarization ticket is stapled into the build. macOS can verify Hindsight\noffline, so the first launch is clean even without a network connection — no\nspurious \"damaged\" or \"cannot be opened\" warnings."},"1241":{"id":"/release-notes-545","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#101","content":"**Steadier installs.** Hardened the DMG so dragging Hindsight to Applications\nand opening it the first time just works."},"1242":{"id":"/release-notes-546","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#101","content":"No feature changes — everything in 1.0.0 below is unchanged."},"1243":{"id":"/release-notes-547","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#100","content":"The first release of Hindsight: a private, on-device daybook for macOS. One\ncontinuous book you turn through page by page, with three pillars and an Index\n(⌘K) that jumps anywhere."},"1244":{"id":"/release-notes-548","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#day-journal","content":"A running record of your day, woven from periodic screen capture read with\non-device OCR (Apple Vision). Turn between days with the left and right arrows,\nlet the red Ribbon bring you back to today, and use **Ask the book** on any page\nto pose a question about your day or your history. Screenshots and the journal\ndatabase never leave your Mac."},"1245":{"id":"/release-notes-549","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#meetings","content":"Record and transcribe meetings on-device. Start one from the Record tile, the\nmenu bar, the Index (**Begin minutes**), or the ⇧⌘M hotkey. Hindsight\ncan watch your calendar and offer to begin a recording when a meeting starts,\nrecognizing Google Meet, Zoom, and Microsoft Teams links."},"1246":{"id":"/release-notes-550","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#meetings","content":"Records your **microphone** and your Mac's **system audio** as separate,\ntime-aligned tracks (the default; **System Audio Only** is also available)."},"1247":{"id":"/release-notes-551","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#meetings","content":"A floating pill and a live panel with **Notes**, a speaker-labeled\n**Transcript**, and an **Ask** tab."},"1248":{"id":"/release-notes-552","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#meetings","content":"Saved meetings keep their transcript, notes, and any Ask conversation, and can\nbe renamed and re-run through prompt templates."},"1249":{"id":"/release-notes-553","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#second-brain","content":"A page that reads across every day you've captured, links the things that keep\nrecurring, and forms plain-language **beliefs** about your focus. It moves\nbetween **Chat**, **Insights**, **Network**, and **Export**. The beliefs,\nInsights, and Network are computed locally and work with no AI provider\nconnected; recall grounds every chat answer in your real history with citations\nback to the moment each claim came from."},"1250":{"id":"/release-notes-554","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#on-device-by-default","content":"**Capture, transcription, and storage stay local.** Meetings are transcribed\non your Mac with the on-device speech model (Parakeet, which runs on the Neural\nEngine), and your journal database never leaves it."},"1251":{"id":"/release-notes-555","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#on-device-by-default","content":"**No AI traffic without a provider you choose.** Until you connect an AI\nprovider, nothing is sent anywhere — Ask the book and the Second Brain simply\nwait."},"1252":{"id":"/release-notes-556","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#on-device-by-default","content":"**A local provider keeps everything on your machine.** Connect Ollama or\nLM Studio and your text is processed locally."},"1253":{"id":"/release-notes-557","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#on-device-by-default","content":"**Cloud is opt-in.** Sending anything to a cloud provider is off until you\nturn it on, and the same gate applies uniformly to journal text, meeting\ntranscripts, chat, and drafts."},"1254":{"id":"/release-notes-558","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#requirements","content":"macOS 14.2 or later."},"1255":{"id":"/release-notes-559","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#requirements","content":"Apple Silicon (M-series) — the on-device speech model runs on the Neural\nEngine."},"1256":{"id":"/release-notes-560","page_id":"/release-notes","tags":["docs"],"type":"text","url":"/release-notes#requirements","content":"A few gigabytes of free disk space for the speech model, which downloads once\nduring first-time setup."},"1257":{"id":"/second-brain","page_id":"/second-brain","type":"page","content":"Memory (Second Brain)","breadcrumbs":["Docs"],"tags":["docs"],"url":"/second-brain"},"1258":{"id":"/second-brain-0","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain","content":"Ask questions across everything Everpaper has kept, see what it has learned about your work, explore connections, and export it."},"1259":{"id":"/second-brain-1","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#how-ready-it-is","content":"How ready it is"},"1260":{"id":"/second-brain-2","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#the-reflection","content":"The Reflection"},"1261":{"id":"/second-brain-3","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#ask","content":"Ask"},"1262":{"id":"/second-brain-4","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#episodes","content":"Episodes"},"1263":{"id":"/second-brain-5","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#you","content":"You"},"1264":{"id":"/second-brain-6","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#insights","content":"Insights"},"1265":{"id":"/second-brain-7","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#connections","content":"Connections"},"1266":{"id":"/second-brain-8","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#export","content":"Export"},"1267":{"id":"/second-brain-9","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#what-it-learns-about-you","content":"What it learns about you"},"1268":{"id":"/second-brain-10","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#how-far-back-it-remembers","content":"How far back it remembers"},"1269":{"id":"/second-brain-11","page_id":"/second-brain","type":"heading","tags":["docs"],"url":"/second-brain#related-reading","content":"Related reading"},"1270":{"id":"/second-brain-12","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain","content":"**Memory** (the sidebar also calls it **Second Brain**) is where Everpaper\nreflects your work back to you. It reads across every day you've captured,\nyour recorded meetings and the folders you include, links the things that keep\nrecurring, and answers your questions with sources."},"1271":{"id":"/second-brain-13","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain","content":"Open **Memory** in the sidebar, or choose **Go → Second Brain**\n(⌘4). Memory has six tabs, on ⌥⌘1 to ⌥⌘6:\n**Ask**, **Episodes**, **You**, **Insights**, **Connections** and **Export**.\n⌥⌘← and ⌥⌘→ move to the previous or next tab. Memory\nopens on Ask."},"1272":{"id":"/second-brain-14","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#how-ready-it-is","content":"The top of the page shows **Still learning you**, **Getting to know you** or\n**Ready**, and how many active days it has seen. Below that are four counts:\n**Days**, **Frames processed** (screenshots), **Topics** (the distinct people,\nfiles, sites and tickets it has found) and **Recurring threads** (any of these\nseen on more than one day). Click the arrow beside the counts to see the\npercentage and a short note. On the Ask tab, the counts sit behind the chart\nbutton (**Memory details**)."},"1273":{"id":"/second-brain-15","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#how-ready-it-is","content":"It turns **Ready** once all four are met: **5 days**, **300 frames**, **60\ndistinct things** and **3 recurring threads**. Readiness follows the weakest of\nthe four, so a lopsided history (many frames but a single day) keeps warming\nuntil it fills out."},"1274":{"id":"/second-brain-16","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#how-ready-it-is","content":"You can ask questions once the page reads **Getting to know you** and an AI\nmodel is connected. Until then, Ask still shows your saved conversations, and\nInsights asks you to keep journaling."},"1275":{"id":"/second-brain-17","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#how-ready-it-is","content":"In **Activity only** (Settings: Events only), Everpaper takes no screenshots,\nso **Frames processed** stays at 0. The page never reaches **Ready**, and no\nReflection is written. Ask still works once the page reads **Getting to know\nyou**. To get the Reflection, choose Screen history or Detailed screen history\n(Settings: Visual history or Adaptive visual history) in **Settings → Daily\nhistory → History mode**."},"1276":{"id":"/second-brain-18","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#the-reflection","content":"With an AI model connected, Everpaper writes a short **Reflection**: up to\nthree observations about your recent work, each marked with the captured\nmoments it comes from (\"From 3 captured moments\"). It's written at the first\nquiet moment after you open Everpaper, and after you end a day. When\nEverpaper starts at login without opening a window, it waits until you open\nit, or for a quiet moment about 15 minutes later. To see it, click the arrow beside the counts\nat the top of Memory; on the Ask tab, click the chart button (**Memory\ndetails**). A model on this Mac keeps it private: Everpaper Native (macOS 27),\noMLX, LM Studio, Ollama or Nativ. See AI on your Mac."},"1277":{"id":"/second-brain-19","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#ask","content":"Type in &#x2A;*Ask a question about your history…** and press Return\n(Shift-Return for a new line). Everpaper answers from\nwhat it has kept: your screen history and activity, up to three recorded\nmeetings, and files in folders you added under **Settings → AI & summaries →\nFiles you include**. It finds those sources by meaning, not only by matching\nwords (see Search by meaning); on macOS 27 that\nincludes what a screenshot shows and what was heard in a meeting."},"1278":{"id":"/second-brain-20","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#ask","content":"Each answer lists its **Sources**. Open one to check the original screen, the\nmeeting passage (**Transcript · 12:34**) or the file. When an answer is a\nnumbered list, each point has **Correct** (save the right version for future\nanswers) and **Forget** (stop using that claim)."},"1279":{"id":"/second-brain-21","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#ask","content":"Conversations are saved: **Conversations** reopens one, and **New\nconversation** starts a fresh one. An empty conversation offers up to three\n**Try asking** questions drawn from your own history."},"1280":{"id":"/second-brain-22","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#ask","content":"Before an answer is saved, Everpaper checks it against the sources it was given\nand removes sentences it can't support. The check is strict but not perfect:\nit can occasionally remove a correct detail or miss an invented name. When an\nanswer matters, open its sources."},"1281":{"id":"/second-brain-23","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#episodes","content":"Episodes is paused in this beta. It was designed to summarize every ten minutes\nof activity and group the summaries into six-hour chapters, but this build\ndoesn't write new ones. On a new install the tab stays empty. Your day is still\nwritten up in Timeline."},"1282":{"id":"/second-brain-24","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#you","content":"**Does this fit?** asks you to confirm details Everpaper inferred, such as your\nrole (**Yes, that's me** / **Not me**). **About you** shows what you wrote in\n**Settings → AI & summaries → Your memory & summaries → About you**. **Who you\nare** is a short portrait your AI model writes from your history; **Refresh**\nwrites it again. **What I'm picking up about you** lists traits drawn from your\nrhythms, the tools you rely on and observations that keep recurring. Confirm\none with ✓ or remove it with ✕. **How your days have felt** charts the mood of\nrecent days."},"1283":{"id":"/second-brain-25","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#insights","content":"**Worth noticing**: patterns rising or cooling across your recent days. Each\ncan become a draft: &#x2A;*Draft email…** opens a preview you send with **Open in\nMail**, and &#x2A;*Draft follow-up event…** one you save with **Add to Calendar**.\nNothing is sent or saved until you choose. Drafts don't need AI."},"1284":{"id":"/second-brain-26","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#insights","content":"**Worth confronting**: up to five frank observations, each shown with its\nevidence. They appear at the default tone, **Balanced**, and at **Candid**. To\nhide them, choose **Supportive** in **Settings → AI & summaries → Your memory\n& summaries → Second Brain tone**. If your history shows nothing worth\nconfronting, the section stays empty."},"1285":{"id":"/second-brain-27","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#insights","content":"**How your picture has changed**: how Memory's understanding of you has\nshifted over time."},"1286":{"id":"/second-brain-28","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#connections","content":"**Your network** lists **Most connected** (the hubs, with how many connections\neach has), **Surprising connections** (pairs seen together more often than\nchance would explain) and **Areas** (clusters). **Show graph** draws up to 120\nrecurring things and their links. When Ask is available, suggested questions\nunder **Ask** open the Ask tab and ask them."},"1287":{"id":"/second-brain-29","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#connections","content":"Click a surprising connection, or a link in the graph, to see why the two go\ntogether: how often they were seen together and when last, the captures where\nboth appear (**Seen together**), and, with an AI model connected, one sentence\nexplaining the link. If the two are really the same thing, choose **Merge**."},"1288":{"id":"/second-brain-30","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#export","content":"**Export** (⌥⌘6) writes files on your Mac; nothing is uploaded.\n**Export Obsidian vault** writes one note per day, with its written entry, your\nnotes, a timeline, and the people, sites and files seen that day. &#x2A;*Export\ngraph (GraphML + Mermaid)** writes your connections as a graph file you can\nopen in yEd or Gephi, plus a Mermaid diagram for Markdown. **Reveal in Finder**\nopens the folder. See Export for where the files go and how to use\nthem."},"1289":{"id":"/second-brain-31","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#what-it-learns-about-you","content":"As you work, Everpaper reads the captured text and pulls out concrete things:\nemail addresses and phone numbers, files, websites (on sites like GitHub, each\nrepository counts as its own thing) and ticket references like `#318`.\nExtraction runs on this Mac on text that has already had secrets removed.\nEveryday plumbing — sign-in pages, analytics, content networks, and\nboilerplate files such as a project's readme — is filtered out. Things that\nkeep appearing together become connections."},"1290":{"id":"/second-brain-32","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#what-it-learns-about-you","content":"From what recurs, Everpaper keeps a short list of one-line beliefs: people you\ndeal with, projects, tools and sites, files you return to, rhythms in your\nwork, and open loops (a file or ticket you touched a couple of times and then\nleft for about a week). They're worked out on your Mac without AI, grow\nstronger when they recur and fade after quiet days. Less certain ones read as\n&#x2A;*(likely)*&#x2A; or &#x2A;*(tentative)**. Observations the Reflection keeps making can\nbecome traits, which you'll see under **What I'm picking up about you**."},"1291":{"id":"/second-brain-33","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#what-it-learns-about-you","content":"Memory has no page that lists the beliefs. They shape Ask's answers, Worth\nconfronting and How your picture has changed. To look one up, type in the\nIndex (⌘K): beliefs appear \"in the Commonplace Book\". You can also\nlist them from the command line. With a model connected, **AI\nrefinement of insights** (Settings → AI & summaries → Your memory & summaries,\non by default) lets the model tidy the list."},"1292":{"id":"/second-brain-34","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#how-far-back-it-remembers","content":"On a new install, Everpaper deletes old material after 30 days. In **Settings →\nPrivacy → How long it stays**, **Keep screenshot images for** sets the window,\nand **Manage saved text… → Also delete expired text & recall data** is on. When\na capture passes that window, Everpaper deletes the image, its text, its search\nentries and the people, files and sites found in it, along with that day's\nrunning notes and written journal entry. The notes you typed in the end-of-day\nreview stay. Memory's Frames processed, Topics and Recurring threads,\nConnections and Ask then reach back only that far. To keep more, choose 90 days\nor Forever, or turn the switch off: images are still deleted, but the text and\nwhat Memory learned from it stay."},"1293":{"id":"/second-brain-35","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#how-far-back-it-remembers","content":"Needs an AI model: Ask, the Reflection, **Who you are**, and the explanation\nin a connection. Works without one: the counts, Insights, Connections and the\ngraph, email and event drafts, and Export. Connect a model under **Settings →\nAI & summaries → AI connection → AI option**. With a cloud provider, Memory\nanswers only after you turn on **Allow cloud AI to analyze your journal**;\nyour questions and the excerpts they cite then go to that provider. The line\nat the top right of Memory shows which case applies (**Private model · Cloud\nAI off**, **Cloud model · Cloud AI on** or **No model connected**). See\nAI on your Mac."},"1294":{"id":"/second-brain-36","page_id":"/second-brain","tags":["docs"],"type":"text","url":"/second-brain#related-reading","content":"Best AI memory apps for Mac: what each one remembers and where data goes."},"1295":{"id":"/updates","page_id":"/updates","type":"page","content":"Updates & Support","breadcrumbs":["Docs"],"tags":["docs"],"url":"/updates"},"1296":{"id":"/updates-0","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates","content":"How to install a new beta, how automatic updates will work after launch, and where to report problems."},"1297":{"id":"/updates-1","page_id":"/updates","type":"heading","tags":["docs"],"url":"/updates#installing-a-new-beta","content":"Installing a new beta"},"1298":{"id":"/updates-2","page_id":"/updates","type":"heading","tags":["docs"],"url":"/updates#automatic-updates-after-launch","content":"Automatic updates (after launch)"},"1299":{"id":"/updates-3","page_id":"/updates","type":"heading","tags":["docs"],"url":"/updates#checking-manually","content":"Checking manually"},"1300":{"id":"/updates-4","page_id":"/updates","type":"heading","tags":["docs"],"url":"/updates#updates-and-your-meetings","content":"Updates and your meetings"},"1301":{"id":"/updates-5","page_id":"/updates","type":"heading","tags":["docs"],"url":"/updates#support-and-feedback","content":"Support and feedback"},"1302":{"id":"/updates-6","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates","content":"**During the private beta, Everpaper does not update itself.** Each new beta\narrives as a private download link. Install it over your current copy, as\nbelow. Automatic updates start with the first public release."},"1303":{"id":"/updates-7","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#installing-a-new-beta","content":"Finish or stop any recording, then quit Everpaper."},"1304":{"id":"/updates-8","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#installing-a-new-beta","content":"Open the new disk image from your latest link and drag **Everpaper** into\n**Applications**. Choose **Replace**."},"1305":{"id":"/updates-9","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#installing-a-new-beta","content":"Open Everpaper again. Your history, settings and models stay where they\nwere."},"1306":{"id":"/updates-10","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#installing-a-new-beta","content":"Use the most recent link you were sent. Older links can stop working once a\nnewer build is out. To see what changed, read the\nrelease notes."},"1307":{"id":"/updates-11","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#installing-a-new-beta","content":"Some betas also have an end date. A few days before it, the top of Settings\ntells you how long is left. After it, Everpaper won't start new meetings or\njournal sessions, but everything you've already recorded stays readable,\nsearchable and exportable. Install the newest beta to record again."},"1308":{"id":"/updates-12","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#installing-a-new-beta","content":"Coming from a Hindsight-branded release? The old update feed has been\nretired, so it won't offer Everpaper. Quit Hindsight, then install Everpaper\nfrom your beta link (or apply at\neverpaper.app/beta) into Applications. It\nuses the same data folder, so your history is kept. Then move the old\nHindsight app to the Trash."},"1309":{"id":"/updates-13","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#automatic-updates-after-launch","content":"Everpaper's update checks are already built in. Choose how they work in\n**Settings → General → Updates** (⌘,):"},"1310":{"id":"/updates-14","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#automatic-updates-after-launch","content":"**Off**: no automatic checks."},"1311":{"id":"/updates-15","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#automatic-updates-after-launch","content":"**Check only** (default): Everpaper checks once a day and asks before\ndownloading."},"1312":{"id":"/updates-16","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#automatic-updates-after-launch","content":"**Check and download**: a found update downloads in the background, ready to\ninstall."},"1313":{"id":"/updates-17","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#automatic-updates-after-launch","content":"No check runs while a meeting is recording."},"1314":{"id":"/updates-18","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#checking-manually","content":"**Everpaper → Check for Updates…** in the app menu, or the same item in the\nEverpaper menu-bar icon"},"1315":{"id":"/updates-19","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#checking-manually","content":"**Settings → General → Updates → Check for Updates…**"},"1316":{"id":"/updates-20","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#checking-manually","content":"⌘K, then **Check for updates**"},"1317":{"id":"/updates-21","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#checking-manually","content":"During the private beta a check always finds nothing, because betas aren't\npublished to the update feed. To see whether a newer beta exists, look at the\nrelease notes. Your copy's version is in **Settings →\nAbout**."},"1318":{"id":"/updates-22","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#updates-and-your-meetings","content":"Everpaper never interrupts a recording to update. Update checks are paused\nwhile a meeting is recording, and an already-downloaded update will not\nrelaunch the app mid-recording. Stop the recording and the update can go\nahead. If you press &#x2A;*Check for Updates…** in Settings during a recording,\nEverpaper shows &#x2A;Finish recording before requesting another Everpaper release\ncheck.* From the menus, the check simply doesn't run. Try again once the\nrecording has ended."},"1319":{"id":"/updates-23","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#support-and-feedback","content":"Found a bug, or have an idea? **Help → Everpaper Help** or **Help → View on\nGitHub** opens the project on GitHub:\ngithub.com/iannellomarco/everpaper.\nOpen an issue there to report a problem or request a feature."},"1320":{"id":"/updates-24","page_id":"/updates","tags":["docs"],"type":"text","url":"/updates#support-and-feedback","content":"Issues on GitHub are public. Don't paste transcripts, screenshots or anything\nelse from your history. Describe the problem in words and include your build\ninfo: open **Settings → About** and press **Copy build info**, then paste it\ninto your report. It lists the version, build and where the app is installed.\nIf that location shows your Mac user name, remove it before posting. You can\nalso see the version in **Everpaper → About Everpaper**."}},"count":1320},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":638,"2":1254,"3":1263,"4":1313,"5":759,"6":1262,"7":891,"8":882,"9":880,"10":1269,"11":1284,"12":687,"13":794,"14":870,"15":765,"16":922,"17":1299,"18":1162,"19":1110,"20":112,"21":1147,"22":1177,"23":897,"24":1300,"25":1120,"26":1186,"27":912,"28":898,"29":978,"30":999,"31":983,"32":1106,"33":868,"34":137,"35":857,"36":929,"37":299,"38":964,"39":984,"40":227,"41":1314,"42":986,"43":313,"44":646,"45":985,"46":64,"47":705,"48":1047,"49":290,"50":0,"51":1,"52":272,"53":958,"54":1130,"55":673,"56":833,"57":851,"58":56,"59":226,"60":139,"61":479,"62":317,"63":324,"64":83,"65":750,"66":915,"67":727,"68":1131,"69":811,"70":627,"71":584,"72":1022,"73":626,"74":585,"75":1023,"76":628,"77":587,"78":878,"79":624,"80":774,"81":877,"82":625,"83":775,"84":889,"85":728,"86":832,"87":376,"88":647,"89":658,"90":377,"91":282,"92":140,"93":298,"94":312,"95":63,"96":1123,"97":1127,"98":973,"99":1297,"100":844,"101":156,"102":853,"103":812,"104":1167,"105":1176,"106":1004,"107":744,"108":850,"109":928,"110":681,"111":875,"112":714,"113":693,"114":1141,"115":894,"116":1157,"117":1281,"118":688,"119":1253,"120":748,"121":934,"122":974,"123":698,"124":1187,"125":1310,"126":888,"127":1124,"128":297,"129":295,"130":412,"131":1273,"132":1240,"133":471,"134":7,"